---
// Cloudflare Web Analytics. The site has been paying for this since 5 July and
// receiving 20 pageloads a month from it: the zone's automatic injection does
// not reach a response served by a Worker, so the beacon was never on the page
// while the dashboard quietly showed a flat line.
//
// Cookieless, no cross-site identifier, nothing stored in the browser — which
// is why it needs no consent banner and why it is the only analytics here.
const TOKEN = 'f833c208ec95461b9d28ca255c477582';
---

<script
  is:inline
  type="module"
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon={`{"token": "${TOKEN}"}`}
></script>

<!-- pro-motion first-party beacon (pm-collector Worker). Classic deferred
     script on purpose: pm.js reads document.currentScript, which is null in
     modules. Cookieless like the CF beacon above; custom events go through
     src/components/analytics/track.ts. -->
<script
  is:inline
  defer
  src="https://pm-collector.igor-ganov.workers.dev/pm.js"
  data-project="dovego-it"></script>
