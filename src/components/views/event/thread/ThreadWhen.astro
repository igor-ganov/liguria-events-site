---
import ThreadHour from './ThreadHour.astro';
import TileMark from './TileMark.astro';
import TileCollage from './TileCollage.astro';
import type { ThreadWhen } from '../../../../lib/events/thread/thread-when.ts';
import type { Ui } from '../../../../lib/i18n/ui-schema.ts';

// The first tile: the day in words, the hour large, how it ends — then either
// "one date only", the span of days, or the run with its next dates. Everything
// a reader came to the page to check, first. "Today" is said on the photograph.
// The outline of the site's mark is drawn from here and runs across the grid.
type Props = Readonly<{ when: ThreadWhen; pictures: readonly string[]; ui: Ui }>;
const { when, pictures, ui } = Astro.props;
const { line, once, span, run } = when;
---

<li class="ev-tile ev-when">
  <TileCollage pictures={pictures} tone="duo" columns={2} />
  <TileMark />
  <h2 class="ev-day">
    {run === undefined && <time datetime={line.iso}>{line.text}</time>}
    {run !== undefined && <span>{run.line}</span>}
    {run !== undefined && <span class="ev-pill">{run.left}</span>}
  </h2>
  <ThreadHour line={line} endUnknown={ui.eventPage.endUnknown} />
  {once !== undefined && <p class="ev-sub">{once}</p>}
  {span !== undefined && <p class="ev-sub">{span}</p>}
  {run !== undefined && (
    <ol class="ev-dates" aria-label={ui.eventPage.dates}>
      {run.dates.map((date, index) => (
        <li class:list={[{ 'is-next': index === 0 }]}>
          <time datetime={date.iso}>{date.text}</time>
          {index === 0 && <span class="visually-hidden"> ({ui.eventPage.nextDate})</span>}
        </li>
      ))}
      {run.more !== undefined && (
        <li class="ev-more">
          {run.more.text} <time datetime={run.more.iso}>{run.more.date}</time>
        </li>
      )}
    </ol>
  )}
</li>
