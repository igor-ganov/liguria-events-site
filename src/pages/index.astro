---
import '../styles/pages/index.css';
import EntryView from '../components/views/EntryView.astro';
import { ENTRY_LOCALE } from '../lib/i18n/entry-locale.ts';
import { uiOf } from '../lib/i18n/ui-of.ts';

// dovego.it itself. Every language has a prefix now, so this address belongs to
// none of them — and it is the one people type, so it answers rather than
// redirecting: `/` has sat in Google's index as a redirect since the site
// began, crawled on 13 July and not since.
//
// It is the Italian door, and it says so: the canonical points at /it/, which
// is where the hreflang cluster has named its x-default all along. The site is
// about events in Italy and its readers read Italian; a reader whose browser
// says otherwise has their links rewritten before they click one (init-entry).
const lang = ENTRY_LOCALE;
const ui = await uiOf(lang);
---

<EntryView lang={lang} page="" title={ui.entry.heading} description={ui.entry.lead} />
