---
import PickStrip from './PickStrip.astro';
import Widget from './Widget.astro';
import { cityName } from '../../../lib/region/city-name.ts';
import { localizedUrl } from '../../../lib/i18n/localized-url.ts';
import { slugify } from '../../../lib/slugify.ts';
import { venuePath } from '../../../lib/events/venue-path.ts';
import type { CompactEvent } from '../../../lib/events/event-schema.ts';
import type { Locale } from '../../../lib/i18n/locales.ts';
import type { Ui } from '../../../lib/i18n/ui-schema.ts';

// Where a reader goes when the page they came for is read. It offered the whole
// region and other years of itself, and nothing else — not its own town, not
// its own venue, not the concert on the next street that night. For a crawler
// it is the same gap: the only path to an event page was scrolling a feed, and
// 17 of 96 sampled pages were in the index.
//
// Every label puts the place first and takes no preposition: one template has
// to serve "Genova", "Teatro Carlo Felice" and "Liguria", and Italian and
// Russian each want something different in front of them.
//
// The venue chip is here only while the venue has no strip of its own above;
// when it has one, the chip closes that strip instead.
type Props = Readonly<{ lang: Locale; event: CompactEvent; also: readonly CompactEvent[]; venueAbove: boolean; ui: Ui }>;
const { lang, event, also, venueAbove, ui } = Astro.props;
const region = event.rg ?? '';
const city = event.ct ?? '';
const place = [city].filter((named) => named !== '').map(cityName).at(0) ?? region;
const venue = event.v ?? '';
---

{(also.length > 0 || city !== '') && (
  <Widget name="also" icon="feed" label={ui.headings.alsoHere.replace('{place}', place)} wide>
    <PickStrip lang={lang} events={also} />
    <p class="widget-chips">
      {city !== '' && (
        <a class="chip" href={localizedUrl(lang, `${region}/${city}/`)}>
          {ui.eventPage.allInCity.replace('{place}', cityName(city))}
        </a>
      )}
      {city !== '' && venue !== '' && !venueAbove && (
        <a class="chip" href={localizedUrl(lang, venuePath(region, city, slugify(venue)))}>
          {ui.eventPage.venuePage.replace('{place}', venue)}
        </a>
      )}
    </p>
  </Widget>
)}
