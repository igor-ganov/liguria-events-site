---
import '../styles/pages/map.css';
import MapView from '../components/views/MapView.astro';

// The country's map. The map has always carried every event in Italy and merely
// opened on a region; this is the same map with no region to open on, so it
// opens on all of it.
const lang = 'en' as const;
---

<MapView lang={lang} region="" />
