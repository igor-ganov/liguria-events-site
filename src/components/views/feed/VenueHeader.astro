---
import { cityName } from '../../../lib/region/city-name.ts';
import { regionName } from '../../../lib/region/region-name.ts';
import { regionUrl } from '../../../lib/region/region-url.ts';
import { localizedUrl } from '../../../lib/i18n/localized-url.ts';
import { countText } from '../../../lib/i18n/count-text.ts';
import type { Locale } from '../../../lib/i18n/locales.ts';
import type { Ui } from '../../../lib/i18n/ui-schema.ts';

// A venue page is a landing page: somebody arrives from a search for the venue
// itself, so the venue has to be the first thing on it. Without this the page
// opened on a filter bar and a list, and never said where it was about.
// It takes the dictionary rather than two strings out of it: a component that
// knows which copy it needs is one fewer thing for the page to thread through.
type Props = Readonly<{ lang: Locale; region: string; city: string; name: string; count: number; ui: Ui }>;
const { lang, region, city, name, count, ui } = Astro.props;
const place = cityName(city);
const { venueCount: label } = ui.seo;
const invite = ui.contribute.venue;
---

<header class="venue-head">
  <p class="venue-crumbs">
    <a href={regionUrl(lang, region)}>{regionName(region)}</a>
    <span aria-hidden="true">›</span>
    <a href={localizedUrl(lang, `${region}/${city}/`)}>{place}</a>
  </p>
  <h1>{name}</h1>
  <p class="venue-sub">{countText(lang, label, count, place)}</p>
  <p class="venue-invite">
    <a href={localizedUrl(lang, "submit/")}>{invite.replace('{place}', name)}</a>
  </p>
</header>
