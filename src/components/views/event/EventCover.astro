---
import EventHero from './EventHero.astro';
import { BRAND_MARK } from '../../../lib/img/brand-mark.ts';
import { iconSvg } from '../../../lib/icons/icon-svg.ts';
import { uiIcon } from '../../../lib/icons/ui-icon.ts';
import type { CompactEvent } from '../../../lib/events/event-schema.ts';
import type { GalleryPhoto } from '../../../lib/events/event-gallery.ts';
import type { Ui } from '../../../lib/i18n/ui-schema.ts';

// The top of the page: every photograph of the event, one at a time, with the
// name of the event over them — the way the feed card that led here looked,
// and the place a reader swipes for the rest. An event that came with no
// picture gets the mark of the site — never a stand-in that says something
// about the event nobody checked.
type Props = Readonly<{ event: CompactEvent; title: string; shots: readonly GalleryPhoto[]; ui: Ui }>;
const { event, title, shots, ui } = Astro.props;
---

<header class="event-cover">
  {shots.length > 0 && (
    <ul class="event-shots" data-shots>
      {shots.map((photo, index) => (
        <li>
          <EventHero photo={photo} title={title} photoBy={ui.photoBy} lead={index === 0} />
        </li>
      ))}
    </ul>
  )}
  {shots.length === 0 && <span class="event-cover-blank" set:html={BRAND_MARK} />}
  <p class="event-cover-tags">
    {event.c.map((category) => (
      <span class="cat-tag" data-cat={category}>
        <Fragment set:html={iconSvg(category, 13)} />
        {ui.cat[category]}
      </span>
    ))}
    {event.f === true && <span class="badge-free">{ui.badges.free}</span>}
    {event.x === true && <span class="badge-gem">{ui.badges.gem}</span>}
    {shots.length > 1 && (
      <span class="event-cover-count">
        <Fragment set:html={uiIcon('photo', 13)} />
        <span><b data-shot-at>1</b>/{shots.length}</span>
      </span>
    )}
  </p>
  {shots.length > 1 && (
    <nav class="event-shot-steps">
      <button type="button" data-shot-step="-1" aria-label={ui.calNav.prev}>‹</button>
      <button type="button" data-shot-step="1" aria-label={ui.calNav.next}>›</button>
    </nav>
  )}
  <h1>{title}</h1>
</header>

<script>
  import { wireEventShots } from '../../event/wire-event-shots.ts';
  document.addEventListener('astro:page-load', wireEventShots);
</script>
