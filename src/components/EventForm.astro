---
import ImageField from './events/ImageField.astro';
import ContactFields from './events/ContactFields.astro';
import VisibilityField from './events/VisibilityField.astro';
import CategoryFields from './events/CategoryFields.astro';
import ProgrammeField from './events/ProgrammeField.astro';
import { uiOf } from '../lib/i18n/ui-of.ts';
import { EMPTY_PREFILL } from '../lib/events/event-prefill.ts';
import type { Prefill } from '../lib/events/event-prefill.ts';
import type { Locale } from '../lib/i18n/locales.ts';

// Shared create/edit form. `mode` switches the submit target (POST /submit vs
// PATCH /event/<id>) and the button label; `event` prefills it on edit.
type Props = Readonly<{
  mode: 'create' | 'edit';
  lang?: Locale | undefined;
  eventId?: string | undefined;
  event?: Prefill | undefined;
  /** The version being edited. Sent back with the change so an edit that sat
   *  in the offline queue cannot overwrite a newer one without being asked. */
  baseUpdatedAt?: string | undefined;
}>;
const { mode, lang = 'en', eventId, event, baseUpdatedAt } = Astro.props;
const ui = await uiOf(lang);
const f = ui.eventForm;
const v: Prefill = event ?? EMPTY_PREFILL;
const SUBMIT_LABEL: Record<Props['mode'], string> = {
  create: f.submitCreate,
  edit: f.submitEdit,
};
---

<form id="event-form" class="submit-form" data-mode={mode} data-id={eventId} data-base-updated={baseUpdatedAt} data-signin-note={ui.submitAuth.signin}>
  <label>{f.title}<input name="title" required maxlength="200" value={v.title} /></label>
  <label>{f.description}<textarea name="description" rows="4" set:text={v.description} /></label>

  <VisibilityField ui={ui} />

  <ImageField ui={ui} coverImage={v.coverImage} />

  <ProgrammeField
    ui={ui}
    container={v.container}
    sessions={v.sessions}
    startDate={v.startDate}
    endDate={v.endDate}
  />
  <ContactFields ui={ui} v={v} />

  <CategoryFields ui={ui} selected={v.categories} />
  <label class="inline"><input type="checkbox" name="free" checked={v.free} /> {f.freeEntry}</label>

  <div class="form-loc">
    <span class="form-image-label">{f.mapLabel}</span>
    <div class="form-loc-map" data-loc-map></div>
    <span class="form-loc-hint">{f.mapHint}</span>
  </div>
  <input type="hidden" name="lat" value={v.lat} data-lat />
  <input type="hidden" name="lng" value={v.lng} data-lng />

  <button type="submit">{SUBMIT_LABEL[mode]}</button>
</form>
<p id="submit-status" role="status" aria-live="polite"></p>

<script>
  import { initEventForm } from './events/init-event-form.ts';
  import { initLocationPicker } from './events/init-location-picker.ts';
  initEventForm();
  initLocationPicker();
</script>
