---
import Layout from '../../layouts/Layout.astro';
import MapCanvas from './map/MapCanvas.astro';
import MapFilters from './map/MapFilters.astro';
import { regionName } from '../../lib/region/region-name.ts';
import { uiOf } from '../../lib/i18n/ui-of.ts';
import type { Locale } from '../../lib/i18n/locales.ts';

type Props = Readonly<{ lang: Locale; region: string }>;
const { lang, region } = Astro.props;
const ui = await uiOf(lang);
const placeName = regionName(region);
const description = ui.seo.map.replace('{place}', placeName);
---

<!-- No `needsEvents`: the corpus is ~2.6 MB of JSON, so it is fetched as a cached
     asset (/data/events.json) after first paint instead of being inlined here. -->
<Layout lang={lang} region={region} title={`${placeName} — ${ui.nav.map}`} description={description} path={`${region}/map/`} needsMap>
  <!-- The map carries every event in the country and merely opens on the region:
       pan or zoom out and the rest are already there. -->
  <script is:inline set:html={`window.__REGION__=${JSON.stringify(region)}`} />
  <h1 class="visually-hidden">{ui.nav.map}</h1>
  <MapFilters ui={ui} />
  <MapCanvas ui={ui} />
</Layout>

<script>
  // Everything the map does lives in src/components/map/ as tested modules;
  // this shell only starts it and releases the WebGL context on SPA nav.
  import { initMap } from '../../components/map/init-map.ts';
  import { teardownMap } from '../../components/map/teardown-map.ts';
  initMap();
  document.addEventListener('astro:after-swap', initMap);
  document.addEventListener('astro:before-swap', teardownMap);
</script>
