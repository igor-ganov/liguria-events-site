---
import Layout from '../../layouts/Layout.astro';
import type { EventDetailProps } from './event-detail-props.ts';
import OwnEventInvite from '../events/OwnEventInvite.astro';
import { keepOutOfSearch } from '../../lib/events/keep-out-of-search.ts';
import NewEventLink from '../events/NewEventLink.astro';
import EventOwnerBar from './event/EventOwnerBar.astro';
import EventActions from './event/EventActions.astro';
import EventCover from './event/EventCover.astro';
import EventFeedback from './event/EventFeedback.astro';
import EventGallery from './event/EventGallery.astro';
import EventPassed from '../events/EventPassed.astro';
import EventProgramme from './event/EventProgramme.astro';
import EventTiles from './event/EventTiles.astro';
import EventWhere from './event/EventWhere.astro';
import EventMapEmbed from './event/EventMapEmbed.astro';
import EventAlso from './event/EventAlso.astro';
import EventEditions from './event/EventEditions.astro';
import EventSources from './event/EventSources.astro';
import PlaceReviews from './place/PlaceReviews.astro';
import { placeReviewSummary } from '../../lib/places/reviews.ts';
import { reviewSubjectOf } from '../../lib/events/review-subject-of.ts';
import { cityName } from '../../lib/region/city-name.ts';
import { alsoOn } from '../../lib/events/also-on.ts';
import { editionsOf } from '../../lib/events/editions-of.ts';
import { eventDetailView } from '../../lib/events/event-detail-view.ts';
import { eventTiles } from '../../lib/events/event-tiles.ts';
import { canonicalUrl } from '../../lib/seo/canonical-url.ts';
import { eventPath } from '../../lib/event-path.ts';
import { isoToday } from '../../lib/calendar/iso-today.ts';
import { programmeLeaves } from '../../lib/events/programme-leaves.ts';
import { upcomingLeaves } from '../../lib/events/upcoming-leaves.ts';
import { regionUrl } from '../../lib/region/region-url.ts';
import { uiOf } from '../../lib/i18n/ui-of.ts';

type Props = EventDetailProps;
const { lang, event, editable = false, status, visibility, contacts } = Astro.props;
// Anything not offered to the feed is kept out of the index too. A crawled
// event has no row and no visibility, and is public by definition.
const unlisted = visibility === 'link';
// The redirect after a successful create carries ?created, which is the only
// way this page can know to lead with the link rather than the event.
const justCreated = Astro.url.searchParams.get('created') === '1';
const ui = await uiOf(lang);
// The address a crawler event carries lives on the event itself; only a
// user-submitted one has a contact block. Structured data needs whichever is
// there — an event with no address at all is rejected outright by Google.
// Read here, once, because two things need it before the reviews section
// renders: the rating tile at the top and the structured data in the head.
const subject = reviewSubjectOf(event);
const rating = await placeReviewSummary(Astro.locals.runtime.env.DB, subject);
const view = eventDetailView({ lang, event, address: contacts?.address ?? event.a, site: Astro.site, today: isoToday(), rating });
const { region, title, seoTitle, desc, descHtml, descPreview, heroImage, cover, more, links, tickets, passed, jsonLd, mapSearchUrl, mapEmbedUrl } = view;
const leaves = upcomingLeaves(programmeLeaves(event, lang), isoToday());
const tiles = eventTiles({ event, lang, labels: { ...ui.eventPage, reviews: ui.reviews.title }, rating });
// The same feast in other years — the archive for the ones that are over, the
// corpus for the one that is coming. A reader landing on a feast that has
// happened wants next year's, and that is the direction the archive alone
// cannot answer.
const editions = await editionsOf(event, Astro.locals.runtime.env.DB);
// What else is on in the same town around the same date. The page offered the
// whole region and other years of itself, and nothing else.
const also = await alsoOn(event, isoToday());
---

<Layout lang={lang} region={region} title={seoTitle} description={descPreview || seoTitle} path={eventPath(event)} image={heroImage} ogType="article" noindex={keepOutOfSearch(status, visibility)}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <article class="event-page">
    <p class="event-topbar">
      <a class="back-link" href={regionUrl(lang, region)}>← {ui.headings.allEvents}</a>
    </p>
    {justCreated && (
      <NewEventLink ui={ui} url={canonicalUrl(lang, eventPath(event), Astro.site)} title={title} unlisted={unlisted} />
    )}
    {editable && <EventOwnerBar eventId={event.id} status={status} />}
    {passed && <EventPassed lang={lang} region={region} city={cityName(event.ct ?? '')} label={ui.passedNote} allLabel={ui.headings.allEvents} />}
    <EventCover event={event} title={title} cover={cover} photos={more.length + 1} ui={ui} />
    <EventTiles tiles={tiles} />
    <EventActions event={event} title={title} tickets={tickets} contacts={contacts} mapSearchUrl={mapSearchUrl} ui={ui} />
    {more.length > 0 && <EventGallery photos={more} photoBy={ui.photoBy} />}
    {leaves.length > 0 && <EventProgramme leaves={leaves} heading={ui.eventPage.programme} />}
    <EventWhere event={event} contacts={contacts} mapSearchUrl={mapSearchUrl} ui={ui} />
    {mapEmbedUrl && <EventMapEmbed src={mapEmbedUrl} title={`${ui.mapLink}: ${event.v ?? title}`} />}
    {desc !== '' && <section class="event-desc" set:html={descHtml} />}
    <p class="site-foot" style="padding:0.4rem 0 0; font-size:0.78rem">{ui.summaryNote}</p>
    <PlaceReviews subject={subject} region={region} ui={ui} />
    <EventEditions lang={lang} heading={ui.headings.editions} editions={editions} />
    <EventAlso lang={lang} event={event} also={also} ui={ui} />
    <EventSources links={links} heading={ui.headings.sources} />
    <EventFeedback event={event} title={title} ui={ui} />
    {!justCreated && <OwnEventInvite ui={ui} lang={lang} />}
  </article>
</Layout>

<script>
  import { initPlaceReviews } from '../../components/places/init-place-reviews.ts';
  // Run for this visit and for every later navigation: a ClientRouter swap
  // brings a new reviews section that has not been wired yet.
  initPlaceReviews();
  document.addEventListener('astro:page-load', initPlaceReviews);
</script>
