---
// Author-only edit page: loads the caller's own event as form values (any other
// viewer, or a missing event, is bounced to the event page / home).
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import EventForm from '../../../components/EventForm.astro';
import { editableEventById } from '../../../lib/events/d1-published.ts';

const { id } = Astro.params;
const user = Astro.locals.user;
const event = user && id ? await editableEventById(Astro.locals.runtime.env.DB, id, user.id) : undefined;
if (event === undefined) return Astro.redirect(id ? `/event/${id}` : '/');
---

<Layout lang="en" title="Edit event" path={`event/${id}/edit/`}>
  <main class="auth-card submit-card">
    <a class="back-link" href={`/event/${id}`}>← Back</a>
    <h1>Edit event</h1>
    <p>Saving re-submits the event for review before the changes go live.</p>
    <EventForm mode="edit" eventId={id} event={event} />
  </main>
</Layout>
