---
import '../../../styles/pages/_lang.calendar._month.css';
import CalendarView from '../../../components/views/CalendarView.astro';
import { cachedEvents } from '../../../data/cached-events.ts';
import { eventMonths } from '../../../lib/calendar/event-months.ts';
import { EVENTS_URL } from '../../../data/events-url.ts';
import { isoToday } from '../../../lib/calendar/iso-today.ts';
import { LOCALES } from '../../../lib/i18n/locales.ts';

// One month of the country, in each language the site is written in.
export const getStaticPaths = async () => {
  const payload = await cachedEvents(EVENTS_URL);
  const months = eventMonths(payload.events, isoToday());
  return LOCALES.flatMap((lang) =>
    months.map((month) => ({ params: { lang, month }, props: { lang, month } })),
  );
};

const { lang, month } = Astro.props;
---

<CalendarView lang={lang} region="" monthKey={month} />
