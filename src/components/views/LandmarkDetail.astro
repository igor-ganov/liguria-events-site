---
import Layout from '../../layouts/Layout.astro';
import LandmarkArticle from './landmark/LandmarkArticle.astro';
import { uiOf } from '../../lib/i18n/ui-of.ts';
import { landmarksFor } from '../../lib/landmarks/landmarks-source.ts';
import { landmarkPath } from '../../lib/landmarks/landmark-path.ts';
import { slug } from '../../lib/slug.ts';
import { localizedUrl } from '../../lib/i18n/localized-url.ts';
import { branch } from '../../lib/branch.ts';
import type { Locale } from '../../lib/i18n/locales.ts';

// Worker-SSR'd (prerender = false) — one route for all ~2.8k landmarks, looked
// up server-side by the slug's token; a real built page (SEO, no client flash).
type Props = Readonly<{ lang: Locale; region: string; slug: string }>;
const { lang, region, slug: raw } = Astro.props;
const ui = await uiOf(lang);
const assets = Astro.locals.runtime.env.ASSETS;
const all = await landmarksFor(assets, region, lang);
// Zero or one match: an array keeps the "not found" case a length, not a branch.
const found = all.filter((l) => slug.matches(l.id, raw)).slice(0, 1);
Astro.response.status = branch(found.length === 0)(() => 404, () => 200);

const path = found.map((l) => landmarkPath(l.region, l.name, l.id))[0] ?? `${region}/landmarks/`;
const title = found.map((l) => l.name)[0] ?? ui.landmarks.title;
const description = found.map((l) => l.desc ?? l.name)[0] ?? ui.landmarks.intro;
const notFound = { en: 'This landmark could not be found.', it: 'Luogo non trovato.', ru: 'Место не найдено.' }[lang];
---

<Layout lang={lang} region={region} title={title} description={description} path={path}>
  <article class="event-page lm-detail">
    <a class="back-link" href={localizedUrl(lang, `${region}/landmarks/`)}>← {ui.landmarks.title}</a>
    {found.map((item) => <LandmarkArticle item={item} ui={ui} lang={lang} region={region} />)}
    {found.length === 0 && <p class="feed-empty">{notFound}</p>}
  </article>
</Layout>
