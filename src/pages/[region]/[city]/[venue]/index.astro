---
import FeedView from '../../../../components/views/FeedView.astro';
import { cachedEvents } from '../../../../data/cached-events.ts';
import { EVENTS_URL } from '../../../../data/events-url.ts';
import { venuesOf } from '../../../../lib/events/venues-of.ts';

// A venue is a real sub-path of its city: /liguria/genova/teatro-carlo-felice/.
// The demand we already surface for is venue-shaped — "acquario di genova
// ferragosto", "acquario eventi genova" — and this is the page that answers it.
// Only venues with enough events get one; see venuesOf.
export const getStaticPaths = async () => {
  const payload = await cachedEvents(EVENTS_URL);
  return venuesOf(payload.events).map((venue) => ({
    params: { region: venue.region, city: venue.city, venue: venue.slug },
    props: { region: venue.region, city: venue.city, venue: { slug: venue.slug, name: venue.name } },
  }));
};

const { region, city, venue } = Astro.props;
---

<FeedView lang="en" region={region} city={city} venue={venue} />
