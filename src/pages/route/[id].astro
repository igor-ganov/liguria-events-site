---
// SSR (not prerendered): a saved route lives only in D1. A public route opens
// for anyone with the link; a private one only for its owner. Anything else —
// missing, or private and not yours — 404s without revealing it exists. The
// owner also gets an in-place editor (reorder / move / remove / add-from-
// favourites); other viewers get the read-only view.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import RouteArticle from '../../components/views/route/RouteArticle.astro';
import { uiOf } from '../../lib/i18n/ui-of.ts';
import { getRoute, listFavorites } from '../../lib/favorites/favorites-db.ts';
import { routeAccess } from '../../lib/favorites/route-access.ts';
import { branch } from '../../lib/branch.ts';

const lang = 'en' as const;
const ui = await uiOf(lang);
const { id } = Astro.params;
const user = Astro.locals.user;
const db = Astro.locals.runtime.env.DB;
const loaded = await Promise.all([id].filter((key) => key !== undefined).map((key) => getRoute(db, key)));
const access = routeAccess(loaded[0], user?.id);
// Zero or one route: only what this viewer may actually open reaches the markup.
const visible = loaded.filter((route) => route !== undefined).filter(() => access.allowed);
Astro.response.status = branch(access.allowed)(() => 200, () => 404);
const notFound = 'This route could not be found.';
const title = visible.map((route) => `${ui.route.title} · ${route.name}`)[0] ?? ui.route.title;
// The owner's favourite ids seed the editor's "add from favourites" picker.
const owners = [user].filter((u) => u !== undefined).filter(() => access.owned);
const favorites = (await Promise.all(owners.map((u) => listFavorites(db, u.id)))).flat();
---

{visible.map((route) => (
  <Layout lang={lang} title={title} path={`route/${id}`}>
    <RouteArticle route={route} ui={ui} id={id} access={access} favorites={favorites} />
  </Layout>
))}
{visible.length === 0 && (
  <Layout lang={lang} title={title}>
    <p class="feed-empty">{notFound}</p>
  </Layout>
)}
