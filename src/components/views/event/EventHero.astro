---
import { resized } from '../../../lib/img/resized.ts';
import type { GalleryPhoto } from '../../../lib/events/event-gallery.ts';

type Props = Readonly<{ photo: GalleryPhoto; title: string; photoBy: string }>;
const { photo, title, photoBy } = Astro.props;
---

<figure class="event-hero">
  <img src={resized(photo.image, 1024)} alt={title} loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" />
  {/* No credit for a picture of ours: the archive mark comes with no source,
      and naming a newspaper under it would be a lie. */}
  {photo.name !== '' && (
    <figcaption>
      {photoBy}:{' '}
      <a href={photo.href} target="_blank" rel="noopener">{photo.name}</a>
    </figcaption>
  )}
</figure>
