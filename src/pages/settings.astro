---
import { ROOT_ONLY } from '../lib/i18n/root-only-locales.ts';
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { uiIcon } from '../lib/icons/ui-icon.ts';
import { passkeysOf } from '../lib/auth/passkeys-of.ts';

const user = Astro.locals.user;
const passkeys = await passkeysOf(Astro.locals.runtime.env.DB)(user);
---

<Layout lang="en" title="Settings" path="settings/" locales={ROOT_ONLY}>
  <section class="auth-card settings-card">
    <h1>Settings</h1>
    <p>Signed in as <strong>{user?.email}</strong> (@{user?.handle}).</p>

    <section class="settings-section">
      <h2>Passkeys</h2>
      <p class="muted">Sign in faster and more securely — Face ID, fingerprint, or device PIN.</p>
      <ul class="passkey-list">
        {passkeys.map((p) => (
          <li data-id={p.id}>
            <span>{p.deviceName} · added {p.createdAt.slice(0, 10)}</span>
            <button type="button" class="link-btn" data-del>Remove</button>
          </li>
        ))}
      </ul>
      <button type="button" id="passkey-register" class="account-signin passkey-btn" hidden><Fragment set:html={uiIcon('key', 16)} /> Add a passkey</button>
      <span id="passkey-status" class="passkey-status" role="status" aria-live="polite"></span>
    </section>

    <button type="button" class="link-btn" data-signout>Sign out</button>
  </section>
</Layout>

<script>
  import { initSettings } from '../components/auth/init-settings.ts';
  initSettings();
</script>
