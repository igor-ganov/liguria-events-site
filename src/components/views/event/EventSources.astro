---
import Widget from './Widget.astro';
import type { NamedLink } from '../../../lib/events/event-links.ts';

// Where the page comes from, and the two ways to talk to us about it. The
// sources and the note that the summary was written from them belong together:
// one says the words are not the organiser's, the other says whose they are.
type Props = Readonly<{ links: readonly NamedLink[]; heading: string; note: string }>;
const { links, heading, note } = Astro.props;
---

<Widget name="sources" icon="globe" label={heading}>
  <p class="widget-small">{note}</p>
  <ul class="widget-chips">
    {links.map((link) => (
      <li>
        <a class="chip" href={link.url} target="_blank" rel="noopener">
          ↗ {link.name}
        </a>
      </li>
    ))}
  </ul>
  <slot />
</Widget>
