---
import FeedView from '../../../components/views/FeedView.astro';
import { cachedEvents } from '../../../data/cached-events.ts';
import { cachedPlaces } from '../../../data/cached-places.ts';
import { EVENTS_URL } from '../../../data/events-url.ts';
import { PLACES_URL } from '../../../data/places-url.ts';

// A city is a real sub-path of its region: /liguria/genova/. Every province
// capital gets one whether or not anything is on in it — deriving the list from
// the events instead meant Savona, a real Ligurian capital with a quiet week,
// answered 404. Static "calendar"/"map"/… segments win over [city].
export const getStaticPaths = async () => {
  const payload = await cachedEvents(EVENTS_URL);
  const places = await cachedPlaces(PLACES_URL, payload.events);
  return Object.entries(places).flatMap(([region, cities]) =>
    cities.map((city) => ({ params: { region, city }, props: { region, city } })),
  );
};

const { region, city } = Astro.props;
---

<FeedView lang="en" region={region} city={city} />
