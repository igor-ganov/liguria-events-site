---
import Layout from '../../layouts/Layout.astro';
import type { EventDetailProps } from './event-detail-props.ts';
import ShareButton from '../share/ShareButton.astro';
import EventOwnerBar from './event/EventOwnerBar.astro';
import EventHero from './event/EventHero.astro';
import EventGalleryMore from './event/EventGalleryMore.astro';
import EventPassed from '../events/EventPassed.astro';
import EventTags from './event/EventTags.astro';
import EventTickets from './event/EventTickets.astro';
import EventFacts from './event/EventFacts.astro';
import EventProgramme from './event/EventProgramme.astro';
import EventMapEmbed from './event/EventMapEmbed.astro';
import EventSources from './event/EventSources.astro';
import { cityName } from '../../lib/region/city-name.ts';
import { eventDetailView } from '../../lib/events/event-detail-view.ts';
import { eventPath } from '../../lib/event-path.ts';
import { isoToday } from '../../lib/calendar/iso-today.ts';
import { programmeSessions } from '../../lib/events/programme-sessions.ts';
import { regionUrl } from '../../lib/region/region-url.ts';
import { uiOf } from '../../lib/i18n/ui-of.ts';

type Props = EventDetailProps;
const { lang, event, editable = false, status, visibility, contacts } = Astro.props;
// Anything not offered to the feed is kept out of the index too. A crawled
// event has no row and no visibility, and is public by definition.
const unlisted = visibility === 'link';
const ui = await uiOf(lang);
// The address a crawler event carries lives on the event itself; only a
// user-submitted one has a contact block. Structured data needs whichever is
// there — an event with no address at all is rejected outright by Google.
const view = eventDetailView({
  lang,
  event,
  address: contacts?.address ?? event.a,
  site: Astro.site,
  today: isoToday(),
});
const { region, title, desc, descHtml, descPreview, heroImage, cover, more, links, tickets, passed, jsonLd, mapSearchUrl, mapEmbedUrl } = view;
const programme = programmeSessions(event, lang);
---

<Layout lang={lang} region={region} title={title} description={descPreview || title} path={eventPath(event.id)} image={heroImage} ogType="article" noindex={unlisted}>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <article class="event-page">
    <p class="event-topbar">
      <a class="back-link" href={regionUrl(lang, region)}>← {ui.headings.allEvents}</a>
      <span class="event-share"><ShareButton ui={ui} title={title} /></span>
    </p>
    {editable && <EventOwnerBar eventId={event.id} status={status} />}
    {passed && (
      <EventPassed
        lang={lang}
        region={region}
        city={cityName(event.ct ?? '')}
        label={ui.passedNote}
        allLabel={ui.headings.allEvents}
      />
    )}
    {cover && <EventHero photo={cover} title={title} photoBy={ui.photoBy} />}
    {more.length > 0 && <EventGalleryMore photos={more} photoBy={ui.photoBy} />}
    <EventTags event={event} title={title} ui={ui} />
    {tickets && <EventTickets href={tickets} label={ui.tickets} />}
    <EventFacts event={event} contacts={contacts} mapSearchUrl={mapSearchUrl} ui={ui} />
    {desc !== '' && <div class="event-desc" set:html={descHtml} />}
    {programme.length > 0 && <EventProgramme sessions={programme} lang={lang} />}
    {mapEmbedUrl && <EventMapEmbed src={mapEmbedUrl} title={`${ui.mapLink}: ${event.v ?? title}`} />}
    <p class="site-foot" style="padding:0.4rem 0 0; font-size:0.78rem">{ui.summaryNote}</p>
    <EventSources links={links} heading={ui.headings.sources} />
  </article>
</Layout>
