---
import { ROOT_ONLY } from '../lib/i18n/root-only-locales.ts';
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import EventForm from '../components/EventForm.astro';
import { uiOf } from '../lib/i18n/ui-of.ts';

// Open to anyone. An organiser arriving from a venue page used to be bounced to
// the home page with a sign-in dialog and no idea what they had been about to
// do; the form is shown first and the account is asked for once, at the point
// it is actually needed. The API refuses an anonymous POST, which is where it
// matters.
const user = Astro.locals.user;
const ui = await uiOf('en');
---

<Layout lang="en" title="Add an event" path="submit/" locales={ROOT_ONLY}>
  <section class="auth-card submit-card">
    <h1>Add an event</h1>
    {user && (
      <p>
        Signed in as <strong>{user.email}</strong>. Every submission is screened against our
        <a href="/content-policy">Content Policy</a> before it can appear.
      </p>
    )}
    {!user && (
      <p>
        {ui.submitAuth.note} Every submission is screened against our
        <a href="/content-policy">Content Policy</a> before it can appear.
      </p>
    )}
    <EventForm mode="create" />
  </section>
</Layout>
