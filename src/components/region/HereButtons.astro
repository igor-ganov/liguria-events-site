---
import type { Ui } from '../../lib/i18n/ui-schema.ts';

// The two shortcuts that ask the browser where the visitor is. They are
// buttons, not links: without a position there is nowhere to go, and a refused
// lookup must leave the current place selected — see wire-region-here.ts.
//
// This is the reader telling us where they are, with a permission they granted.
// It used to be overruled before the page loaded by a 302 built from an IP
// lookup; it is the answer that wins now, so it says so in their language
// rather than in English on an Italian site.
type Props = Readonly<{ ui: Ui }>;
const { ui } = Astro.props;
---

<div class="rp-here">
  <button type="button" data-region-here="city">
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="3.2"></circle>
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
    </svg>
    {ui.entry.hereCity}
  </button>
  <button type="button" data-region-here="region">
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c3 3.4 3 14.6 0 18M12 3c-3 3.4-3 14.6 0 18"></path>
    </svg>
    {ui.entry.hereRegion}
  </button>
</div>
