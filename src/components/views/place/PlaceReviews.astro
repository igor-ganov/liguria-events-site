---
import PlaceReviewForm from './PlaceReviewForm.astro';
import { branch } from '../../../lib/branch.ts';
import { placeReviewSummary, placeReviewList } from '../../../lib/places/reviews.ts';
import { myReviewOf } from '../../../lib/places/my-review-of.ts';
import { reviewStars } from '../../../lib/places/review-stars.ts';
import type { Ui } from '../../../lib/i18n/ui-schema.ts';

// Our own reviews (D1): summary + recent list, and the caller's own review if
// signed in. A row of five star icons, the first `n` lit — rendered server-side.
// The thing reviewed is named by `subject` — a place's open-data id or an
// event's `evt:` key — so one section serves both pages.
type Props = Readonly<{ subject: string; region: string; ui: Ui }>;
const { subject, region, ui } = Astro.props;
const db = Astro.locals.runtime.env.DB;
const user = Astro.locals.user;
const [summary, reviews, mine] = await Promise.all([
  placeReviewSummary(db, subject),
  placeReviewList(db, subject),
  myReviewOf(db, subject, user?.id),
]);
---

<section class="place-reviews" id="reviews" data-rv data-place={subject} data-region={region}>
  <h2>
    {ui.reviews.title}
    {summary.count > 0 && (
      <span class="rv-summary"><Fragment set:html={reviewStars(summary.avg)} /> {summary.avg} · {summary.count}</span>
    )}
  </h2>

  {user && <PlaceReviewForm mine={mine} ui={ui} />}
  {!user && <a class="rv-signin chip chip--layer" href="?signin">{ui.reviews.signIn}</a>}

  {branch(reviews.length > 0)(
    () => (
      <ul class="rv-list">
        {reviews.map((r) => (
          <li class="rv-item">
            <div class="rv-item-head"><Fragment set:html={reviewStars(r.rating)} /> <span class="rv-author">{r.handle}</span> <time>{r.createdAt.slice(0, 10)}</time></div>
            {r.comment && <p class="rv-comment">{r.comment}</p>}
          </li>
        ))}
      </ul>
    ),
    () => <p class="rv-none">{ui.reviews.none}</p>,
  )}
</section>
