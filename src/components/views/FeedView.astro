---
import Layout from '../../layouts/Layout.astro';
import FeedFilters from './feed/FeedFilters.astro';
import FeedGroups from './feed/FeedGroups.astro';
import EmptyState from './feed/EmptyState.astro';
import SubscribeBar from './feed/SubscribeBar.astro';
import VenueHeader from './feed/VenueHeader.astro';
import { cachedEvents } from '../../data/cached-events.ts';
import { EVENTS_URL } from '../../data/events-url.ts';
import { categoryIconsJson } from '../../lib/icons/category-icons-json.ts';
import { dayHeading } from '../../lib/calendar/day-heading.ts';
import { feedViewModel } from '../../lib/events/feed-view-model.ts';
import { isoToday } from '../../lib/calendar/iso-today.ts';
import { siteJsonLd } from '../../lib/seo/site-json-ld.ts';
import { uiOf } from '../../lib/i18n/ui-of.ts';
import type { FeedProps } from './feed/feed-props.ts';

type Props = FeedProps;
const { lang, region, city, venue, facet, today: given } = Astro.props;
const ui = await uiOf(lang);

// Server-rendered feed: the cards ship in the HTML (fast LCP, crawlable, no
// layout shift). Filtering is show/hide on the client — no re-render, and no
// Lit/Effect runtime on this page. A city or venue page pre-filters here, so
// there is no client-side flash from region → city.
const payload = await cachedEvents(EVENTS_URL);
const today = given ?? isoToday();
const view = feedViewModel({ lang, scope: { region, city, venue, facet, today }, events: payload.events, today, ui });
const { events, groups, placeName, title, description, path, onward } = view;
const heading = dayHeading(ui);
---

<Layout lang={lang} region={region} city={city} title={title} description={description} path={path}>
  <script is:inline type="application/ld+json" set:html={siteJsonLd()} />
  {venue === undefined && <h1 class="visually-hidden">{ui.nav.feed}</h1>}
  {venue !== undefined && (
    <VenueHeader
      lang={lang}
      region={region}
      city={city ?? ''}
      name={venue.name}
      count={events.length}
      label={ui.seo.venueCount}
    />
  )}

  {groups.length > 0 && <FeedFilters ui={ui} today={today} />}

  <div data-feed-list data-city={city ?? ''} data-today={today}>
    <FeedGroups groups={groups} heading={heading} ui={ui} lang={lang} />
  </div>
  {groups.length === 0 && (
    <EmptyState
      heading={ui.nothingHere.heading}
      note={ui.nothingHere.note.replace('{place}', placeName)}
      href={onward}
      label={ui.nothingHere.onward}
    />
  )}
  <p class="feed-empty" data-feed-empty hidden>{ui.empty}</p>
  <SubscribeBar region={region} city={city} site={Astro.site} ui={ui} />
</Layout>

<script is:inline type="application/json" id="icons-data" set:html={categoryIconsJson()} />

<script>
  import { initFeed } from '../../components/feed/init-feed.ts';
  // Re-init on every navigation (astro:page-load fires on first load AND after
  // each ClientRouter swap), so filters + sort are restored from the URL when
  // you come back — a one-time initFeed() left a back-navigated feed unsorted.
  document.addEventListener('astro:page-load', initFeed);
</script>
