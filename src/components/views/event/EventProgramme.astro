---
import Widget from './Widget.astro';
import type { DescriptionPart } from '../../../lib/description/description-outline.ts';
import type { ProgrammeLeaf } from '../../../lib/events/programme-leaves.ts';

// The programme as calendar leaves: weekday, the day number large, and under it
// every hour that day starts. A long run scrolls sideways instead of pushing
// the rest of the page a screen further down. What the event wrote about its
// programme is the same thing in words, so it folds under the leaves: there
// for whoever wants every line, and not a second list down the page.
type Props = Readonly<{ leaves: readonly ProgrammeLeaf[]; heading: string; written: DescriptionPart | undefined; whole: string }>;
const { leaves, heading, written, whole } = Astro.props;
---

<Widget name="programme" icon="calendar" label={heading} wide>
  <ol class="event-leaves">
    {leaves.map((leaf) => (
      <li>
        <time datetime={leaf.iso}>
          <small>{leaf.weekday}</small>
          <b>{leaf.day}</b>
          <small>{leaf.month}</small>
        </time>
        {leaf.times.length > 0 && <span class="leaf-times">{leaf.times.join(' · ')}</span>}
        {leaf.title !== undefined && <span class="leaf-title">{leaf.title}</span>}
      </li>
    ))}
  </ol>
  {written !== undefined && (
    <details class="widget-fold">
      <summary>{whole}</summary>
      <Fragment set:html={written.html} />
    </details>
  )}
</Widget>
