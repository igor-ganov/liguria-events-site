---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

// Pure markup: reaching this page means the link did NOT sign anyone in.
// A usable magic-link token is spent by the middleware, which sets the session
// cookie and redirects before rendering ever starts — so the only case left
// here is a spent, expired or unknown token.
---

<Layout lang="en" title="Sign-in link" path="auth/verify/">
  <main class="auth-card">
    <h1>Link expired or already used</h1>
    <p>Sign-in links work only once and for five minutes. Please request a fresh one.</p>
    <a class="btn" href="/?signin=1">Back to sign in</a>
  </main>
</Layout>
