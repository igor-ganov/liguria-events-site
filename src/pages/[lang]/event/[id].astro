---
// Localized twin of /event/[id] — the same resolution, through the same module,
// so a source an event can come from cannot be added to one route and forgotten
// in the other.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import EventDetail from '../../../components/views/EventDetail.astro';
import { cachedEvents } from '../../../data/cached-events.ts';
import { EVENTS_URL } from '../../../data/events-url.ts';
import EmptyState from '../../../components/views/feed/EmptyState.astro';
import { eventStatusCode } from '../../../lib/events/event-status-code.ts';
import { resolveEvent } from '../../../lib/events/resolve-event.ts';
import { DEFAULT_REGION } from '../../../lib/region/default-region.ts';
import { regionUrl } from '../../../lib/region/region-url.ts';
import { uiOf } from '../../../lib/i18n/ui-of.ts';
import { LOCALES } from '../../../lib/i18n/locales.ts';

const { lang: langParam, id = '' } = Astro.params;
const lang = LOCALES.find((l) => l === langParam && l !== 'en');
switch (lang) {
  case undefined:
    return new Response(null, { status: 404 });
}

const corpus = await cachedEvents(EVENTS_URL);
const { event, editable, status, contacts } = await resolveEvent({
  id,
  corpus: corpus.events,
  db: Astro.locals.runtime.env.DB,
  userId: Astro.locals.user?.id,
  eventsUrl: EVENTS_URL,
});
Astro.response.status = eventStatusCode(id, event !== undefined);
const ui = await uiOf(lang);
---

{event && <EventDetail lang={lang} event={event} editable={editable} status={status} contacts={contacts} />}
{
  event === undefined && (
    <Layout lang={lang} title={ui.gone.heading}>
      <EmptyState
        heading={ui.gone.heading}
        note={ui.gone.note}
        href={regionUrl(lang, DEFAULT_REGION)}
        label={ui.gone.onward}
      />
    </Layout>
  )
}
