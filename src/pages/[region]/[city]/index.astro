---
import FeedView from '../../../components/views/FeedView.astro';
import { cachedEvents } from '../../../data/cached-events.ts';
import { EVENTS_URL } from '../../../data/events-url.ts';
import { regionsAndCitiesOf } from '../../../lib/region/regions-cities-of.ts';

// A city is a real sub-path of its region: /liguria/genova/. One page per
// (region, city) with events, server-filtered to the city — no client flash.
// Static "calendar"/"map"/… segments win over [city], so they never collide.
export const getStaticPaths = async () => {
  const payload = await cachedEvents(EVENTS_URL);
  return regionsAndCitiesOf(payload.events).flatMap((group) =>
    group.cities.map((c) => ({ params: { region: group.slug, city: c.slug }, props: { region: group.slug, city: c.slug } })),
  );
};

const { region, city } = Astro.props;
---

<FeedView lang="en" region={region} city={city} />
