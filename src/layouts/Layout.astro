---
import MobileMenu from '../components/MobileMenu.astro';
import NavProgress from './parts/NavProgress.astro';
import OfflineNotice from './parts/OfflineNotice.astro';
import OutboxNotice from './parts/OutboxNotice.astro';
import ShellScripts from './parts/ShellScripts.astro';
import SigninDialog from './parts/SigninDialog.astro';
import SiteFooter from './parts/SiteFooter.astro';
import SiteHead from './parts/SiteHead.astro';
import SiteHeader from './parts/SiteHeader.astro';
import { pageEvents } from './page-events.ts';
import { uiOf } from '../lib/i18n/ui-of.ts';
import { LEGACY_REGION } from '../lib/region/legacy-region.ts';
import { LOCALES } from '../lib/i18n/locales.ts';
import type { LayoutProps } from './layout-props.ts';
// No stylesheet is imported here. Each page imports its own, cut from the
// sheets of the site to what that page uses (scripts/build-page-styles.ts);
// importing one here would put the whole of them back on every page.

type Props = LayoutProps;
const {
  lang,
  title,
  region = LEGACY_REGION,
  city,
  description = "What's on in Italy — auto-collected events",
  path = '',
  needsEvents = false,
  needsMap = false,
  image,
  ogType = 'website',
  noindex = false,
  locales = LOCALES,
  picker = true,
} = Astro.props;
const payload = await pageEvents(needsEvents);
const ui = await uiOf(lang);
const uiData = JSON.stringify({ lang, ui });
---

<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead {...{ lang, title, description, path, needsMap, image, ogType, noindex, locales, region, city }} site={Astro.site} />
  </head>
  <body>
    <NavProgress />
    <OfflineNotice />
    <OutboxNotice />
    <SiteHeader picker={picker} lang={lang} region={region} path={path} city={city} ui={ui} locales={locales} />
    {payload && <script is:inline type="application/json" id="events-data" set:html={JSON.stringify(payload.events)} />}
    <script is:inline type="application/json" id="ui-data" set:html={uiData} />
    <main>
      <slot />
    </main>
    <MobileMenu lang={lang} path={path} region={region} locales={locales} />
    <SiteFooter ui={ui} lang={lang} generatedAt={payload?.generatedAt} />
    <SigninDialog ui={ui} />
    <ShellScripts />
  </body>
</html>
