---
// Localized twin of /event/[id] — same SSR resolution (crawler corpus, then D1,
// with author-preview) so user events resolve on /it/ and /ru/ too.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import EventDetail from '../../../components/views/EventDetail.astro';
import { cachedEvents } from '../../../data/cached-events.ts';
import { EVENTS_URL } from '../../../data/events-url.ts';
import { eventForDetail } from '../../../lib/events/d1-published.ts';
import type { EventContacts } from '../../../lib/events/d1-published.ts';
import { decodeEventList } from '../../../lib/events/decode-event-list.ts';
import { LOCALES } from '../../../lib/i18n/locales.ts';
import { branch } from '../../../lib/branch.ts';
import type { CompactEvent } from '../../../lib/events/event-schema.ts';

const { lang: langParam, id } = Astro.params;
const lang = LOCALES.find((l) => l === langParam && l !== 'en');
switch (lang) {
  case undefined:
    return new Response(null, { status: 404 });
}

const user = Astro.locals.user;
const eventId = id ?? '';
const corpus = await cachedEvents(EVENTS_URL);
const fromCorpus = corpus.events.find((e) => e.id === eventId);
// Missing from the build corpus → look it up in D1.
const row = await branch(fromCorpus === undefined && eventId !== '')(
  () => eventForDetail(Astro.locals.runtime.env.DB, eventId, user?.id),
  async () => undefined,
);
const rows = [row].filter((r) => r !== undefined);
const event: CompactEvent | undefined = fromCorpus ?? decodeEventList(rows.map((r) => r.compact))[0];
const editable = rows.some((r) => r.owned);
const status: string | undefined = rows[0]?.status;
const contacts: EventContacts | undefined = rows[0]?.contacts;
Astro.response.status = branch(event === undefined)(() => 404, () => 200);
const notFound = 'This event could not be found.';
---

{event && <EventDetail lang={lang} event={event} editable={editable} status={status} contacts={contacts} />}
{
  event === undefined && (
    <Layout lang={lang} title="Event not found">
      <p class="feed-empty">{notFound}</p>
    </Layout>
  )
}
