---
import ImageField from './events/ImageField.astro';
import CategoryFields from './events/CategoryFields.astro';
import ProgrammeField from './events/ProgrammeField.astro';
import { uiOf } from '../lib/i18n/ui-of.ts';
import { EMPTY_PREFILL } from '../lib/events/event-prefill.ts';
import type { Prefill } from '../lib/events/event-prefill.ts';

// Shared create/edit form. `mode` switches the submit target (POST /submit vs
// PATCH /event/<id>) and the button label; `event` prefills it on edit.
type Props = Readonly<{ mode: 'create' | 'edit'; eventId?: string | undefined; event?: Prefill | undefined }>;
const { mode, eventId, event } = Astro.props;
const ui = await uiOf('en');
const v: Prefill = event ?? EMPTY_PREFILL;
const SUBMIT_LABEL: Record<Props['mode'], string> = { create: 'Submit for review', edit: 'Save changes' };
---

<form id="event-form" class="submit-form" data-mode={mode} data-id={eventId}>
  <label>Title<input name="title" required maxlength="200" value={v.title} /></label>
  <label>Description<textarea name="description" rows="4" set:text={v.description} /></label>

  <ImageField coverImage={v.coverImage} />

  <ProgrammeField
    container={v.container}
    sessions={v.sessions}
    startDate={v.startDate}
    endDate={v.endDate}
  />
  <label>Venue<input name="venue" maxlength="200" value={v.venue} /></label>
  <label>Address<input name="address" maxlength="300" value={v.address} placeholder="Street, city" /></label>
  <div class="row2">
    <label>Phone<input name="phone" type="tel" maxlength="40" value={v.phone} /></label>
    <label>Website<input name="website" type="url" maxlength="300" value={v.website} placeholder="https://" /></label>
  </div>

  <CategoryFields ui={ui} selected={v.categories} />
  <label class="inline"><input type="checkbox" name="free" checked={v.free} /> Free entry</label>

  <div class="form-loc">
    <span class="form-image-label">Location on the map</span>
    <div class="form-loc-map" data-loc-map></div>
    <span class="form-loc-hint">Click the map to drop a pin — drag it to fine-tune.</span>
  </div>
  <input type="hidden" name="lat" value={v.lat} data-lat />
  <input type="hidden" name="lng" value={v.lng} data-lng />

  <button type="submit">{SUBMIT_LABEL[mode]}</button>
</form>
<p id="submit-status" role="status" aria-live="polite"></p>

<script>
  import { initEventForm } from './events/init-event-form.ts';
  import { initLocationPicker } from './events/init-location-picker.ts';
  initEventForm();
  initLocationPicker();
</script>
