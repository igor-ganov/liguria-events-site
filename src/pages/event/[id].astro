---
// SSR (not prerendered): an event page must resolve BOTH crawler events (the
// build corpus) and user-submitted events, which live only in D1 and therefore
// never had a static page. A not-yet-published event is shown only to its
// author, and one that has already happened comes from the collector's archive.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/views/feed/EmptyState.astro';
import EventDetail from '../../components/views/EventDetail.astro';
import { cachedEvents } from '../../data/cached-events.ts';
import { EVENTS_URL } from '../../data/events-url.ts';
import { eventStatusCode } from '../../lib/events/event-status-code.ts';
import { resolveEvent } from '../../lib/events/resolve-event.ts';
import { DEFAULT_REGION } from '../../lib/region/default-region.ts';
import { regionUrl } from '../../lib/region/region-url.ts';
import { uiOf } from '../../lib/i18n/ui-of.ts';

const { id = '' } = Astro.params;
const corpus = await cachedEvents(EVENTS_URL);
const { event, editable, status, visibility, contacts } = await resolveEvent({
  id,
  corpus: corpus.events,
  db: Astro.locals.runtime.env.DB,
  userId: Astro.locals.user?.id,
  eventsUrl: EVENTS_URL,
});
// 410 when one of our ids resolves to nothing: it existed and is permanently
// over, which is what a search engine acts on. 404 stays for what never was.
Astro.response.status = eventStatusCode(id, event !== undefined);
const ui = await uiOf('en');
---

{event && <EventDetail lang="en" event={event} editable={editable} status={status} visibility={visibility} contacts={contacts} />}
{
  event === undefined && (
    <Layout lang="en" title={ui.gone.heading}>
      <EmptyState
        heading={ui.gone.heading}
        note={ui.gone.note}
        href={regionUrl('en', DEFAULT_REGION)}
        label={ui.gone.onward}
      />
    </Layout>
  )
}
