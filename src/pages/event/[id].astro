---
// SSR (not prerendered): an event page must resolve BOTH crawler events (the
// build corpus) and user-submitted events, which live only in D1 and therefore
// never had a static page — the cause of "published event, link 404s". A
// not-yet-published event is shown only to its author (post-submit preview).
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import EventDetail from '../../components/views/EventDetail.astro';
import { cachedEvents } from '../../data/cached-events.ts';
import { EVENTS_URL } from '../../data/events-url.ts';
import { eventForDetail } from '../../lib/events/d1-published.ts';
import { decodeEventList } from '../../lib/events/decode-event-list.ts';
import type { CompactEvent } from '../../lib/events/event-schema.ts';

const { id } = Astro.params;
const user = Astro.locals.user;
const corpus = await cachedEvents(EVENTS_URL);
let event: CompactEvent | undefined = corpus.events.find((e) => e.id === id);
let editable = false;
let status: string | undefined;
if (event === undefined && id) {
  const found = await eventForDetail(Astro.locals.runtime.env.DB, id, user?.id);
  if (found) {
    event = decodeEventList([found.compact])[0];
    editable = found.owned;
    status = found.status;
  }
}
if (event === undefined) Astro.response.status = 404;
const notFound = 'This event could not be found.';
---

{
  event ? (
    <EventDetail lang="en" event={event} editable={editable} status={status} />
  ) : (
    <Layout lang="en" title="Event not found">
      <p class="feed-empty">{notFound}</p>
    </Layout>
  )
}
