---
import '../../styles/pages/_lang.map.css';
import MapView from '../../components/views/MapView.astro';
import { LOCALES } from '../../lib/i18n/locales.ts';

// The country's map: the same map that has always carried every event in Italy,
// with no region to open on, so it opens on all of it.
export const getStaticPaths = () =>
  LOCALES.filter((lang) => lang !== 'en').map((lang) => ({ params: { lang }, props: { lang } }));

const { lang } = Astro.props;
---

<MapView lang={lang} region="" />
