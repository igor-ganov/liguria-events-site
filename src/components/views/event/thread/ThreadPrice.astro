---
import ExternalMark from '../../../shared/ExternalMark.astro';
import TileCollage from './TileCollage.astro';
import { priceLine } from '../../../../lib/events/thread/price-line.ts';
import { threadLabelsOf } from '../../../../lib/events/thread/thread-labels-of.ts';
import type { CompactEvent } from '../../../../lib/events/event-schema.ts';
import type { Locale } from '../../../../lib/i18n/locales.ts';
import type { Ui } from '../../../../lib/i18n/ui-schema.ts';

// The price tile: what it costs, and where the tickets are when a ticket
// seller is among the sources.
type Props = Readonly<{ lang: Locale; event: CompactEvent; tickets: string | undefined; wide: boolean; pictures: readonly string[]; ui: Ui }>;
const { lang, event, tickets, wide, pictures, ui } = Astro.props;
const price = priceLine(lang, threadLabelsOf(ui))(event);
---

<li class:list={['ev-tile', 'ev-price', { 'ev-tile--wide': wide }]}>
  <TileCollage pictures={pictures} tone="duo" columns={3} />
  <p class="ev-lab">{ui.eventPage.cost}</p>
  <p class="ev-price-text">
    <b class:list={[{ 'ev-free': price.free }]}>{price.text}</b>
    {tickets !== undefined && (
      <a href={tickets} target="_blank" rel="noopener">{ui.tickets}<span class="ev-ext"><ExternalMark label={ui.a11y.newTab} /></span></a>
    )}
  </p>
</li>
