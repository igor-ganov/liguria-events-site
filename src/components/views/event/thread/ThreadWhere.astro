---
import ExternalMark from '../../../shared/ExternalMark.astro';
import TileCollage from './TileCollage.astro';
import { placeLines } from '../../../../lib/events/thread/place-lines.ts';
import { venueLink } from '../../../../lib/events/venue-link.ts';
import type { CompactEvent } from '../../../../lib/events/event-schema.ts';
import type { DescriptionPart } from '../../../../lib/description/description-outline.ts';
import type { EventContacts } from '../../../../lib/events/d1-published.ts';
import type { Locale } from '../../../../lib/i18n/locales.ts';
import type { Ui } from '../../../../lib/i18n/ui-schema.ts';

// The second tile: the venue — a link to its own page when it is a place with
// one — the address under it, how to get there when the event wrote more than
// the address, and what a reader does next as plain words: directions, the
// website, a call. Share is on the photograph, beside the heart.
type Props = Readonly<{
  lang: Locale;
  event: CompactEvent;
  address: string | undefined;
  contacts: EventContacts | undefined;
  mapSearchUrl: string | undefined;
  way: DescriptionPart | undefined;
  pictures: readonly string[];
  ui: Ui;
}>;
const { lang, event, address, contacts, mapSearchUrl, way, pictures, ui } = Astro.props;
const page = venueLink(lang)(event);
const { street, town } = placeLines(event, address);
const phone = contacts?.phone?.replace(/\s+/g, '');
---

<li class="ev-tile ev-where">
  <TileCollage pictures={pictures} tone="screen" columns={2} />
  <p class="ev-lab">{ui.eventPage.where}</p>
  {event.v !== undefined && (
    <h2 class="ev-venue">
      {page !== undefined && <a href={page}>{event.v}</a>}
      {page === undefined && event.v}
    </h2>
  )}
  <address class="ev-addr">
    {street !== undefined && <span>{street}</span>}
    {town !== undefined && <b>{town}</b>}
  </address>
  {way !== undefined && <section class="ev-way" set:html={way.html} />}
  <p class="ev-links">
    {mapSearchUrl && <a href={mapSearchUrl} target="_blank" rel="noopener">{ui.eventPage.directions}<span class="ev-ext"><ExternalMark label={ui.a11y.newTab} /></span></a>}
    {contacts?.website && <a href={contacts.website} target="_blank" rel="noopener">{ui.eventPage.website}<span class="ev-ext"><ExternalMark label={ui.a11y.newTab} /></span></a>}
    {phone && <a href={`tel:${phone}`}>{ui.eventPage.call}</a>}
  </p>
</li>
