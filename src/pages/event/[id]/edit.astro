---
// Author-only edit page: loads the caller's own event as form values (any other
// viewer, or a missing event, is bounced to the event page / home).
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import EventForm from '../../../components/EventForm.astro';
import { editableEventById } from '../../../lib/events/d1-published.ts';
import { branch } from '../../../lib/branch.ts';
import { eventIdOfPath } from '../../../lib/events/event-id-of-path.ts';

const { id } = Astro.params;
const user = Astro.locals.user;
// The address carries the event's words now; the row is still keyed by the id.
const eventId = eventIdOfPath(id ?? '');
const userId = user?.id ?? '';
const event = await branch(eventId !== '' && userId !== '')(
  () => editableEventById(Astro.locals.runtime.env.DB, eventId, userId),
  async () => undefined,
);
switch (event) {
  case undefined:
    return Astro.redirect(branch(eventId !== '')(() => `/event/${eventId}`, () => '/'));
}
---

<Layout lang="en" title="Edit event" path={`event/${id}/edit/`}>
  <section class="auth-card submit-card">
    <a class="back-link" href={`/event/${id}`}>← Back</a>
    <h1>Edit event</h1>
    <p>Saving re-submits the event for review before the changes go live.</p>
    <EventForm mode="edit" eventId={id} event={event} />
  </section>
</Layout>
