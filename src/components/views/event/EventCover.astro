---
import CoverTags from './CoverTags.astro';
import EventHero from './EventHero.astro';
import ShareButton from '../../share/ShareButton.astro';
import UiIcon from '../../shared/UiIcon.astro';
import { BRAND_MARK } from '../../../lib/img/brand-mark.ts';
import { favButtonHtml } from '../../../lib/favorites/fav-button-html.ts';
import { isoToday } from '../../../lib/calendar/iso-today.ts';
import { threadLabelsOf } from '../../../lib/events/thread/thread-labels-of.ts';
import { threadWhen } from '../../../lib/events/thread/thread-when.ts';
import type { CompactEvent } from '../../../lib/events/event-schema.ts';
import type { GalleryPhoto } from '../../../lib/events/event-gallery.ts';
import type { Locale } from '../../../lib/i18n/locales.ts';
import type { Ui } from '../../../lib/i18n/ui-schema.ts';

// The top of the page: every photograph of the event, one at a time, with the
// name of the event over them — the way the feed card that led here looked,
// and the place a reader swipes for the rest. An event that came with no
// picture gets the mark of the site — never a stand-in that says something
// about the event nobody checked. The categories and "today" sit in the top
// left corner; keeping it and passing it on are two bold buttons in the right.
type Props = Readonly<{ lang: Locale; event: CompactEvent; title: string; shots: readonly GalleryPhoto[]; ui: Ui }>;
const { lang, event, title, shots, ui } = Astro.props;
const today = threadWhen(lang, threadLabelsOf(ui))(event, isoToday()).line.isToday;
---

<header class="event-cover">
  {shots.length > 0 && (
    <ul class="event-shots" data-shots>
      {shots.map((photo, index) => (
        <li>
          <EventHero photo={photo} title={title} photoBy={ui.photoBy} lead={index === 0} />
        </li>
      ))}
    </ul>
  )}
  {shots.length === 0 && <span class="event-cover-blank" set:html={BRAND_MARK} />}
  <CoverTags event={event} today={today} shots={shots.length} ui={ui} />
  {shots.length > 1 && (
    <nav class="event-shot-steps">
      <button type="button" data-shot-step="-1" aria-label={ui.calNav.prev}><UiIcon name="chevronLeft" size={22} /></button>
      <button type="button" data-shot-step="1" aria-label={ui.calNav.next}><UiIcon name="chevronRight" size={22} /></button>
    </nav>
  )}
  <p class="event-cover-acts">
    <Fragment set:html={favButtonHtml(event.id, ui.nav.favorites)} />
    <ShareButton ui={ui} title={title}><UiIcon slot="icon" name="share" size={24} /></ShareButton>
  </p>
  <h1>{title}</h1>
</header>

<script>
  import { wireEventShots } from '../../event/wire-event-shots.ts';
  document.addEventListener('astro:page-load', wireEventShots);
</script>
