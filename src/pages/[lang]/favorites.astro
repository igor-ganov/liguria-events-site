---
import Layout from '../../layouts/Layout.astro';
import { uiOf } from '../../lib/i18n/ui-of.ts';
import { CATEGORIES } from '../../lib/events/categories.ts';
import { iconSvg } from '../../lib/icons/icon-svg.ts';
import { DEFAULT_REGION } from '../../lib/region/default-region.ts';
import { LOCALES } from '../../lib/i18n/locales.ts';
import { isoToday } from '../../lib/calendar/iso-today.ts';

export const getStaticPaths = () => LOCALES.filter((loc) => loc !== 'en').map((lang) => ({ params: { lang } }));

const lang = LOCALES.find((loc) => loc === Astro.params.lang) ?? 'en';
const ui = await uiOf(lang);
const today = isoToday();
const iconsJson = JSON.stringify(Object.fromEntries(CATEGORIES.map((c) => [c, iconSvg(c, 12)])));
---

<Layout lang={lang} region={DEFAULT_REGION} title={ui.nav.favorites} path="favorites/">
  <h1>{ui.nav.favorites}</h1>
  <div class="fav-tools" data-fav-tools hidden>
    <div class="route-dates">
      <label>{ui.range.from} <input type="date" data-route-from value={today} /></label>
      <label>{ui.range.to} <input type="date" data-route-to /></label>
    </div>
    <div class="route-modes" role="group" aria-label={ui.route.generate}>
      <button class="chip" data-route-mode="walking" aria-pressed="true">{ui.route.walk}</button>
      <button class="chip" data-route-mode="driving" aria-pressed="false">{ui.route.drive}</button>
      <button class="chip" data-route-mode="transit" aria-pressed="false">{ui.route.transit}</button>
    </div>
    <div class="route-actions">
      <button class="route-generate" data-route-generate>{ui.route.generate}</button>
      <button class="route-save" data-route-save hidden>{ui.route.save}</button>
    </div>
  </div>
  <p class="route-share" data-route-share hidden></p>
  <div class="route-map" data-route-map hidden></div>
  <div class="route-output" data-route-output></div>
  <section class="route-mine" data-route-mine hidden>
    <h2>{ui.route.mine}</h2>
    <ul class="route-mine-list" data-route-mine-list></ul>
  </section>
  <ul class="feed-list" data-fav-list></ul>
  <p class="feed-empty" data-fav-empty>{ui.route.empty}</p>
</Layout>

<script is:inline type="application/json" id="icons-data" set:html={iconsJson} />

<script>
  import { initFavoritesPage } from '../../components/favorites/init-favorites-page.ts';
  import { initRoute } from '../../components/favorites/init-route.ts';
  import { initMyRoutes } from '../../components/favorites/init-my-routes.ts';
  // Run for THIS visit (a ClientRouter swap runs this script after the swap,
  // and astro:page-load may already have fired), plus every later navigation.
  const run = () => { initFavoritesPage(); initRoute(); initMyRoutes(); };
  run();
  document.addEventListener('astro:page-load', run);
</script>
