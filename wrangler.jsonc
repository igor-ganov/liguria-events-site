{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dovego",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // ── Production (dovego.it) — the default env: `wrangler deploy` ──
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "production",
    "CRAWLER_ENABLED": "1",
    "FIXED_TODAY": "",
    "PASSKEY_RP_ID": "dovego.it",
    "PASSKEY_ORIGIN": "https://dovego.it",
    "PUBLIC_ORIGIN": "https://dovego.it",
    "MAIL_FROM": "Dove Go <no-reply@send.dovego.it>",
    "ADMIN_EMAILS": "igor.ganov@gmail.com,igor_ganov@yahoo.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dovego", "database_id": "2f65133c-071e-4366-8214-e0942845f792" }
  ],
  "kv_namespaces": [{ "binding": "SESSION", "id": "8b7c9fc86355423c8c143d7dc8f18506" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "dovego-uploads" }],
  "routes": [
    { "pattern": "dovego.it", "custom_domain": true },
    // www stays a custom domain so the name resolves at all, but it is NOT a
    // second site: a zone-level redirect rule (phase http_request_dynamic_redirect,
    // "Redirects" ruleset, added 2026-10-31) answers every www request with a
    // 301 to the apex before the worker and before static assets. It served the
    // whole site at 200 until then, which is why bingbot spent 8 446 of its
    // 12 507 daily fetches on www redirects and Applebot half its budget there.
    // A redirect in middleware cannot replace it: prerendered pages never reach
    // the worker.
    { "pattern": "www.dovego.it", "custom_domain": true }
  ],
  "env": {
    // ── Dev (dev.dovego.it) — `wrangler deploy --env dev` ──
    "dev": {
      "name": "dovego-dev",
      "vars": {
        "ENVIRONMENT": "dev",
        "CRAWLER_ENABLED": "0",
        "FIXED_TODAY": "2026-07-06",
        "PASSKEY_RP_ID": "dev.dovego.it",
        "PASSKEY_ORIGIN": "https://dev.dovego.it",
        "PUBLIC_ORIGIN": "https://dev.dovego.it",
        "MAIL_FROM": "Dove Go <no-reply@send.dovego.it>",
    "ADMIN_EMAILS": "igor.ganov@gmail.com,igor_ganov@yahoo.com"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        { "binding": "DB", "database_name": "dovego-dev", "database_id": "cf5ff131-46c0-40bc-b97c-b0dff591344c" }
      ],
      "kv_namespaces": [{ "binding": "SESSION", "id": "71a97b9d5c814596aa2834aed3bf76b6" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "dovego-uploads-dev" }],
      "routes": [{ "pattern": "dev.dovego.it", "custom_domain": true }]
    }
  }
}
