---
import '../styles/pages/calendar.css';
import CalendarView from '../components/views/CalendarView.astro';
import { isoToday } from '../lib/calendar/iso-today.ts';
import { monthKeyOf } from '../lib/calendar/month-key-of.ts';

// The country's calendar for this month. It used to be a 302 into whichever
// region an IP lookup suggested — the calendar was a region's own page and an
// address that named no region had to have one invented for it. The region is a
// filter now (the picker in the header), not a segment of the URL.
const lang = 'en' as const;
---

<CalendarView lang={lang} region="" monthKey={monthKeyOf(isoToday())} />
