---
import { CATEGORIES } from '../../lib/events/categories.ts';
import type { Ui } from '../../lib/i18n/ui-schema.ts';

type Props = Readonly<{ ui: Ui; selected: readonly string[] }>;
const { ui, selected } = Astro.props;
---

<fieldset class="cats">
  <legend>{ui.eventForm.categories}</legend>
  {CATEGORIES.map((c) => (
    <label class="cat-check">
      <input type="checkbox" name="category" value={c} checked={selected.includes(c)} /> {ui.cat[c]}
    </label>
  ))}
</fieldset>
