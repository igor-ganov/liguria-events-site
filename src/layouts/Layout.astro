---
import { ClientRouter } from 'astro:transitions';
import { cachedEvents } from '../data/cached-events.ts';
import { EVENTS_URL } from '../data/events-url.ts';
import MobileMenu from '../components/MobileMenu.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import RegionPicker from '../components/RegionPicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { uiOf } from '../lib/i18n/ui-of.ts';
import { localizedUrl } from '../lib/i18n/localized-url.ts';
import { regionUrl } from '../lib/region/region-url.ts';
import { DEFAULT_REGION } from '../lib/region/default-region.ts';
import { LOCALES } from '../lib/i18n/locales.ts';
import { DEFAULT_LOCALE } from '../lib/i18n/default-locale.ts';
import type { Locale } from '../lib/i18n/locales.ts';
import '../styles/global.css';

type Props = Readonly<{
  lang: Locale;
  title: string;
  region?: string;
  city?: string | undefined;
  description?: string;
  path?: string;
  needsEvents?: boolean;
  needsMap?: boolean;
  image?: string | undefined;
}>;
const {
  lang,
  title,
  region = DEFAULT_REGION,
  city,
  description = "What's on in Italy — auto-collected events",
  path = '',
  needsEvents = false,
  needsMap = false,
  image,
} = Astro.props;

// The basemap tiles live on a separate host (e.g. tiles.dovego.it). Preconnecting
// on map pages saves the DNS+TLS round-trip before the many pmtiles range
// requests — a real win on a throttled connection. Undefined when tiles are
// same-origin (no PUBLIC_PMTILES_URL), where a preconnect would be pointless.
const tilesOrigin = (() => {
  const url = import.meta.env.PUBLIC_PMTILES_URL;
  try {
    return url ? new URL(url).origin : undefined;
  } catch {
    return undefined;
  }
})();

// og:locale expects a language_TERRITORY tag, not the bare ISO code.
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', it: 'it_IT', ru: 'ru_RU' };

// Only feed / calendar / map embed the full event list; every other page skips
// this ~44 KB (compressed) island and the build-time fetch entirely.
// `path` is "<region>/", "<region>/calendar/2026-07/" or "<region>/map/" — the
// part after the region is the page the picker keeps you on. A specific month
// collapses to the calendar index: another region may have no events that month
// and therefore no page for it.
const rest = path.split('/').slice(1).filter((part) => part !== '');
// On a city page (path = <region>/<city>/) the second segment is the city, not
// a sub-page — switching region then goes to that region's feed, not a
// non-existent /<region>/<city>/.
const page = city !== undefined ? '' : rest.length === 0 ? '' : `${rest[0]}/`;
const payload = needsEvents ? await cachedEvents(EVENTS_URL) : null;
const ui = await uiOf(lang);
const uiData = JSON.stringify({ lang, ui });
const alternates = LOCALES.map((loc) => ({
  loc,
  href: new URL(localizedUrl(loc, path), Astro.site).toString(),
}));
const canonical = new URL(localizedUrl(lang, path), Astro.site).toString();
const xDefault = new URL(localizedUrl(DEFAULT_LOCALE, path), Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="hsl(28 92% 52%)" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
    />
    <title>{title} · Dove Go</title>
    {needsMap && tilesOrigin && <link rel="preconnect" href={tilesOrigin} crossorigin />}
    {needsMap && tilesOrigin && <link rel="dns-prefetch" href={tilesOrigin} />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ loc, href }) => <link rel="alternate" hreflang={loc} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dove Go" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <ClientRouter />
    <script is:inline>
      // No-flash theme init: preference is 'light' | 'dark' | 'system'
      // (default). 'system' resolves to the OS scheme. data-theme carries the
      // RESOLVED scheme (drives colours + the map filter); data-theme-pref
      // carries the user's choice (drives the toggle icon). The localStorage
      // key is shared across the user's project pages — pages that only accept
      // 'dark'/'light' treat 'system' as unknown and fall back to OS, which is
      // exactly what 'system' means, so behaviour stays consistent.
      (function () {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var pref = function () {
          var s = localStorage.getItem('theme');
          return s === 'dark' || s === 'light' || s === 'system' ? s : 'system';
        };
        var resolve = function (p) {
          return p === 'system' ? (mq.matches ? 'dark' : 'light') : p;
        };
        var apply = function (doc) {
          var p = pref();
          doc.documentElement.dataset['theme'] = resolve(p);
          doc.documentElement.dataset['themePref'] = p;
        };
        apply(document);
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument);
        });
      })();
    </script>
  </head>
  <body>
    {/* A thin top progress bar: appears the instant a navigation starts
        (astro:before-preparation) and completes on page-load — immediate
        feedback so a slow ClientRouter navigation reads as "loading", not a
        frozen tap. transition:persist keeps it through the view-transition swap;
        it drives forward AND back navigation (both fire the same events). */}
    <div id="nav-progress" transition:persist aria-hidden="true"></div>
    <script is:inline>
      (function () {
        if (window.__navProgressBound) return;
        window.__navProgressBound = true;
        var bar = function () { return document.getElementById('nav-progress'); };
        var start = function () {
          var el = bar();
          if (!el) return;
          // Reset instantly, then creep toward 90% so the motion reads as progress.
          el.style.transition = 'none';
          el.style.opacity = '1';
          el.style.transform = 'scaleX(0)';
          void el.offsetWidth;
          el.style.transition = 'transform 8s cubic-bezier(0.1, 0.7, 0.1, 1)';
          el.style.transform = 'scaleX(0.9)';
        };
        var done = function () {
          var el = bar();
          if (!el || el.style.opacity === '0') return;
          el.style.transition = 'transform 0.2s ease, opacity 0.4s ease 0.15s';
          el.style.transform = 'scaleX(1)';
          el.style.opacity = '0';
        };
        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:after-swap', done);
        document.addEventListener('astro:page-load', done);
      })();
    </script>
    <header class="site-head">
      <p class="site-title">
        <a class="brand" href={regionUrl(lang, region)} aria-label="Dove Go — home">
          <svg class="brand-mark" viewBox="0 0 32 40" width="19" height="24" aria-hidden="true">
            <path
              d="M16 1.6C8.6 1.6 2.6 7.5 2.6 14.9 2.6 24.4 16 38.4 16 38.4S29.4 24.4 29.4 14.9C29.4 7.5 23.4 1.6 16 1.6Z"
              fill="var(--brand)"
            ></path>
            <path
              d="M8.2 16.4C10.7 12.7 13.6 12.7 16 16.4 18.4 20.1 21.3 20.1 23.8 16.4"
              fill="none"
              stroke="#fff"
              stroke-width="2.7"
              stroke-linecap="round"
            ></path>
          </svg>
          <span class="brand-word">Dove <span class="brand-go">Go</span></span>
        </a>
      </p>
      <nav aria-label="Site">
        <a href={regionUrl(lang, region)}>{ui.nav.feed}</a>
        <a href={regionUrl(lang, region, 'calendar/')}>{ui.nav.calendar}</a>
        <a href={regionUrl(lang, region, 'map/')}>{ui.nav.map}</a>
        <a href={regionUrl(lang, region, 'landmarks/')}>{ui.nav.landmarks}</a>
        <a href={regionUrl(lang, region, 'places/')}>{ui.nav.places}</a>
        <a class="nav-fav" href={localizedUrl(lang, 'favorites/')}>
          {ui.nav.favorites}<span class="fav-badge" data-fav-count hidden></span>
        </a>
        <a href="https://t.me/liguria_events_bot" rel="noopener">{ui.nav.bot}</a>
        <a
          href="https://liguria-events-bot.igor-ganov.workers.dev/calendar.ics"
          rel="noopener">{ui.nav.ical}</a
        >
        <LanguageSwitcher lang={lang} path={path} />
        <ThemeToggle ui={ui} />
        <span class="account" data-account><span class="acct-skeleton" aria-hidden="true"></span></span>
      </nav>
      <!-- Outside the nav on purpose: the nav is hidden on a phone, and the
           region is the one control that must stay reachable everywhere. -->
      <RegionPicker lang={lang} region={region} page={page} city={city} />
    </header>
    {payload && <script is:inline type="application/json" id="events-data" set:html={JSON.stringify(payload.events)} />}
    <script is:inline type="application/json" id="ui-data" set:html={uiData} />
    <main>
      <slot />
    </main>
    <MobileMenu lang={lang} path={path} region={region} />
    <footer class="site-foot">
      <p>
        {ui.footer}{payload ? ` · data as of ${payload.generatedAt.slice(0, 16)}Z` : ''} ·
        <a href="https://github.com/igor-ganov/liguria-events-site" rel="noopener">source</a>
      </p>
      <p class="foot-legal">
        <a href="/content-policy">Content policy</a> ·
        <a href="/terms">Terms</a> ·
        <a href="/privacy">Privacy</a>
      </p>
    </footer>

    <dialog id="signin-dialog" class="signin-dialog" aria-label={ui.auth.signIn}>
      <form method="dialog" class="signin-x-row">
        <button class="signin-x" value="close" aria-label="Close">✕</button>
      </form>
      <h2>{ui.auth.title}</h2>

      <div data-step="email">
        <p>{ui.auth.emailPrompt}</p>
        <form id="signin-form">
          <input type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
          <button type="submit">{ui.auth.sendCode}</button>
        </form>
        <!-- Passkey retry: the modal auto-runs on open, but if it's dismissed the
             viewer can re-trigger it here — this ceremony offers a local passkey
             AND "use a passkey on another device" over QR. -->
        <button type="button" class="link-btn passkey-link" data-passkey-retry hidden>{ui.auth.passkey}</button>
      </div>

      <div data-step="code" hidden>
        <p>{ui.auth.codePre} <strong data-code-email></strong> {ui.auth.codePost}</p>
        <form id="code-form">
          <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code"
            pattern="[0-9]{6}" maxlength="6" placeholder="123456" />
          <button type="submit">{ui.auth.verify}</button>
        </form>
        <button type="button" class="link-btn" data-code-back>← {ui.auth.back}</button>
      </div>

      <p id="signin-status" role="status" aria-live="polite"></p>
    </dialog>
    <script>
      // Three-way theme cycle (light → dark → system) with circular reveal;
      // re-bound after SPA swap. data-theme = resolved scheme, data-theme-pref
      // = user choice.
      const html = document.documentElement;
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const NEXT: Record<string, string> = { light: 'dark', dark: 'system', system: 'light' };
      const NAME_KEY: Record<string, string> = {
        light: 'nameLight',
        dark: 'nameDark',
        system: 'nameSystem',
      };
      const resolve = (pref: string): string =>
        pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref;
      // Relabel every toggle with the current mode (aria + visible menu label).
      const syncButtons = (pref: string): void => {
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
          const name = btn.dataset[NAME_KEY[pref] ?? 'nameSystem'] ?? pref;
          btn.setAttribute('aria-label', `${btn.dataset['label'] ?? ''} (${name})`);
          const label = btn.querySelector<HTMLElement>('[data-theme-name]');
          if (label) label.textContent = name;
        });
      };
      const applyPref = (pref: string): void => {
        html.dataset['theme'] = resolve(pref);
        html.dataset['themePref'] = pref;
        localStorage.setItem('theme', pref);
        syncButtons(pref);
      };
      const cycle = (event: MouseEvent): void => {
        const pref = NEXT[html.dataset['themePref'] ?? 'system'] ?? 'light';
        if (!document.startViewTransition) {
          applyPref(pref);
          return;
        }
        const { clientX: x, clientY: y } = event;
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        html.style.setProperty('--x', `${x}px`);
        html.style.setProperty('--y', `${y}px`);
        html.style.setProperty('--r', `${r}px`);
        document.startViewTransition({ update: () => applyPref(pref), types: ['theme'] });
      };
      // While on 'system', follow live OS scheme changes (no reveal).
      mq.addEventListener('change', () => {
        if (html.dataset['themePref'] === 'system') html.dataset['theme'] = resolve('system');
      });
      const bind = (): void => {
        document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
          if (btn.dataset['themeBound'] === 'true') return;
          btn.dataset['themeBound'] = 'true';
          btn.addEventListener('click', cycle);
        });
        syncButtons(html.dataset['themePref'] ?? 'system');
      };
      bind();
      document.addEventListener('astro:after-swap', bind);
    </script>

    <script>
      // Swap dead event covers (expired source URLs) for the category tile.
      import { initImageFallback } from '../components/shared/image-fallback.ts';
      initImageFallback();
      document.addEventListener('astro:page-load', initImageFallback);
    </script>

    <script>
      // Favourites (localStorage + D1 sync on sign-in), star toggles + count.
      import { initFavorites } from '../components/favorites/init-favorites.ts';
      initFavorites();
      document.addEventListener('astro:page-load', initFavorites);
    </script>

    <script>
      import { startAuthentication, startRegistration } from '@simplewebauthn/browser';
      import { readUiIsland } from '../components/shared/read-ui-island.ts';

      // Sign-in dialog + header account state. Most pages are prerendered, so the
      // header cannot know the viewer server-side — the account slot is resolved
      // client-side from /api/auth/me. Re-run after SPA swaps (DOM is replaced).
      const auth = readUiIsland().ui.auth;
      type Me = { user: { handle: string; role: string } | null };
      const hasWebAuthn = (): boolean => Boolean(globalThis.PublicKeyCredential);
      const dialog = (): HTMLDialogElement | null => document.querySelector('#signin-dialog');
      const setStatus = (text: string): void => {
        const el = document.querySelector('#signin-status');
        if (el) el.textContent = text;
      };
      const showStep = (step: 'email' | 'code'): void => {
        document.querySelector('[data-step="email"]')?.toggleAttribute('hidden', step !== 'email');
        document.querySelector('[data-step="code"]')?.toggleAttribute('hidden', step !== 'code');
      };
      const esc = (s: string): string =>
        s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] ?? c);
      let pendingEmail = '';
      let passkeyBusy = false;

      const signOut = async (): Promise<void> => {
        await fetch('/api/auth/logout', { method: 'POST' });
        location.href = '/';
      };

      // Passkey sign-in via the MODAL ceremony (not autofill): the browser offers
      // BOTH a local passkey AND "use a passkey on another device" over QR — the
      // only way to sign in on a phone with the passkey kept on a laptop. Auto-run
      // on open; the email form stays visible so dismissing the sheet just falls
      // back to email. Nothing hangs — the promise settles on use or cancel.
      const passkeyLogin = async (): Promise<void> => {
        if (!hasWebAuthn() || passkeyBusy) return;
        passkeyBusy = true;
        try {
          const opt = (await (await fetch('/api/passkey/auth-options', { method: 'POST' })).json()) as {
            challengeId: string;
            options: import('@simplewebauthn/browser').PublicKeyCredentialRequestOptionsJSON;
          };
          const response = await startAuthentication({ optionsJSON: opt.options });
          setStatus(auth.verifying);
          const res = await fetch('/api/passkey/auth-verify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ challengeId: opt.challengeId, response }),
          });
          if (res.ok) {
            location.reload();
            return;
          }
          setStatus(auth.passkeyFailed);
        } catch {
          // Cancelled the passkey sheet, or none was offered — the email form is
          // right here, so we clear the status and let them type their email.
          setStatus('');
        } finally {
          passkeyBusy = false;
        }
      };

      // First-time passkey registration: ask for the PLATFORM authenticator so it
      // lands on Windows Hello / Touch ID on this device rather than a phone.
      const passkeyRegister = async (): Promise<boolean> => {
        try {
          const opt = (await (
            await fetch('/api/passkey/register-options', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ attachment: 'platform' }),
            })
          ).json()) as {
            challengeId: string;
            options: import('@simplewebauthn/browser').PublicKeyCredentialCreationOptionsJSON;
          };
          const response = await startRegistration({ optionsJSON: opt.options });
          const res = await fetch('/api/passkey/register-verify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ challengeId: opt.challengeId, response }),
          });
          return res.ok;
        } catch {
          return false;
        }
      };

      const openSignin = (): void => {
        showStep('email');
        setStatus('');
        dialog()?.showModal();
        // Show the passkey retry affordance only where WebAuthn exists.
        const retry = document.querySelector<HTMLElement>('[data-passkey-retry]');
        if (retry) retry.hidden = !hasWebAuthn();
        document.querySelector<HTMLInputElement>('#signin-form input[name=email]')?.focus();
        void passkeyLogin();
      };

      const stripAuthParams = (): void => {
        const url = new URL(location.href);
        ['signin', 'setup', 'next'].forEach((p) => url.searchParams.delete(p));
        // Keep history.state — the ClientRouter's navigation index lives there.
        history.replaceState(history.state, '', url.pathname + url.search + url.hash);
      };

      // The logged-in header collapses to ONE profile button (same footprint as
      // "Sign in"), so the reserved slot never shifts. Its menu holds the
      // profile-specific actions. The mobile FAB is already an open popup, so it
      // gets the flat list instead of a nested dropdown.
      const menuItems = (user: NonNullable<Me['user']>): string => {
        const admin =
          user.role === 'admin'
            ? `<a role="menuitem" href="/admin/">${auth.moderation}</a>` +
              `<a role="menuitem" href="/admin/users/">${auth.users}</a>`
            : '';
        return (
          `<a role="menuitem" class="account-submit" href="/submit">+ ${auth.addEvent}</a>` +
          admin +
          `<a role="menuitem" href="/settings">${auth.settings}</a>` +
          `<button type="button" role="menuitem" class="account-signout" data-signout>${auth.signOut}</button>`
        );
      };

      const renderAccount = (user: Me['user']): void => {
        document.querySelectorAll('[data-account]').forEach((slot) => {
          if (!user) {
            slot.innerHTML = `<button type="button" class="account-signin" data-signin>${auth.signIn}</button>`;
            return;
          }
          const handle = esc(user.handle);
          slot.innerHTML = slot.classList.contains('fab-account')
            ? menuItems(user)
            : `<div class="acct-menu" data-acct-menu>` +
              `<button type="button" class="account-trigger" data-acct-toggle aria-haspopup="menu" aria-expanded="false" aria-label="${auth.account}">` +
              `<span class="acct-avatar" aria-hidden="true">${handle.slice(0, 1).toUpperCase()}</span>` +
              `<span class="acct-name">@${handle}</span>` +
              `</button>` +
              `<div class="acct-dropdown" data-acct-dropdown role="menu" hidden>${menuItems(user)}</div>` +
              `</div>`;
        });
      };

      const refreshAccount = async (): Promise<Me['user']> => {
        try {
          const me = ((await (await fetch('/api/auth/me')).json()) as Me).user;
          renderAccount(me);
          return me;
        } catch {
          renderAccount(null);
          return null;
        }
      };

      // One delegated document handler for every account/menu interaction, so it
      // survives SPA swaps without accumulating listeners.
      let delegated = false;
      const bindDelegates = (): void => {
        if (delegated) return;
        delegated = true;
        document.addEventListener('click', (e) => {
          const el = e.target instanceof Element ? e.target : null;
          if (!el) return;
          if (el.closest('[data-signin]')) return openSignin();
          if (el.closest('[data-signout]')) return void signOut();
          const toggle = el.closest('[data-acct-toggle]');
          document.querySelectorAll<HTMLElement>('[data-acct-menu]').forEach((menu) => {
            const drop = menu.querySelector<HTMLElement>('[data-acct-dropdown]');
            const t = menu.querySelector<HTMLElement>('[data-acct-toggle]');
            if (!drop || !t) return;
            const open = toggle !== null && menu.contains(toggle) ? drop.hasAttribute('hidden') : false;
            drop.toggleAttribute('hidden', !open);
            t.setAttribute('aria-expanded', String(open));
          });
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          document.querySelectorAll<HTMLElement>('[data-acct-dropdown]').forEach((d) => d.setAttribute('hidden', ''));
          document
            .querySelectorAll<HTMLElement>('[data-acct-toggle]')
            .forEach((t) => t.setAttribute('aria-expanded', 'false'));
        });
      };

      const bindSignin = (): void => {
        const form = document.querySelector<HTMLFormElement>('#signin-form');
        if (form && form.dataset['emailBound'] !== 'true') {
          form.dataset['emailBound'] = 'true';
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            pendingEmail = String(new FormData(form).get('email') ?? '');
            setStatus(auth.sending);
            const res = await fetch('/api/auth/request', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: pendingEmail }),
            });
            if (!res.ok) return setStatus(auth.invalidEmail);
            const target = document.querySelector('[data-code-email]');
            if (target) target.textContent = pendingEmail;
            showStep('code');
            setStatus('');
            document.querySelector<HTMLInputElement>('#code-form input[name=code]')?.focus();
          });
        }
        const codeForm = document.querySelector<HTMLFormElement>('#code-form');
        if (codeForm && codeForm.dataset['bound'] !== 'true') {
          codeForm.dataset['bound'] = 'true';
          codeForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const code = String(new FormData(codeForm).get('code') ?? '').trim();
            setStatus(auth.verifying);
            const res = await fetch('/api/auth/verify-code', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: pendingEmail, code }),
            });
            const data = (await res.json().catch(() => ({}))) as { ok?: boolean; isNew?: boolean };
            if (res.ok && data.ok) location.href = data.isNew ? '/?setup=passkey' : '/';
            else setStatus(auth.badCode);
          });
        }
        const back = document.querySelector<HTMLElement>('[data-code-back]');
        if (back && back.dataset['bound'] !== 'true') {
          back.dataset['bound'] = 'true';
          back.addEventListener('click', () => {
            showStep('email');
            setStatus('');
          });
        }
        const retry = document.querySelector<HTMLElement>('[data-passkey-retry]');
        if (retry && retry.dataset['bound'] !== 'true') {
          retry.dataset['bound'] = 'true';
          retry.addEventListener('click', () => void passkeyLogin());
        }
      };

      const initAuthUi = async (): Promise<void> => {
        bindDelegates();
        bindSignin();
        const user = await refreshAccount();
        const params = new URLSearchParams(location.search);
        // A signed-in viewer must never reach the sign-in form — strip the param
        // (from links, history, bookmarks) and never open the dialog.
        if (user) {
          if (params.has('signin') || params.has('setup') || params.has('next')) {
            const wantsSetup = params.has('setup') && hasWebAuthn();
            stripAuthParams();
            if (wantsSetup) void passkeyRegister();
          }
          return;
        }
        if (params.has('signin')) openSignin();
        if (params.has('setup')) stripAuthParams(); // stale link, not signed in
      };
      void initAuthUi();
      document.addEventListener('astro:after-swap', () => void initAuthUi());
    </script>
  </body>
</html>
