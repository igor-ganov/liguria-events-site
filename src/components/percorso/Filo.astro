---
import Capo from './Capo.astro';

// The list also says where its feed's quick pages start, which of them it is,
// and whether a chip filters it in place (read-feed-params.ts).
type Props = Readonly<{
  region: string;
  city: string;
  today: string;
  hasDays: boolean;
  quickBase?: string | undefined;
  quick?: string | undefined;
  toggle?: boolean | undefined;
}>;
const { region, city, today, hasDays, quickBase, quick, toggle } = Astro.props;
---

{/* The thread runs only where there is a sequence of dates. The veil covers
    what has not been read yet and is sticky, so the browser keeps it at the
    reading line by itself; the frayed end says the announced days ran out. */}
<section
  class="percorso"
  data-feed-list
  data-region={region}
  data-city={city}
  data-today={today}
  data-quick-base={quickBase}
  data-quick={quick}
  data-quick-toggle={[''].filter(() => toggle === true).at(0)}
>
  {hasDays && <span class="velo-filo" aria-hidden="true"></span>}
  <slot />
  {hasDays && <Capo />}
</section>
