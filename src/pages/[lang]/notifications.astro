---
import { VAPID_PUBLIC_KEY } from '../../lib/pwa/vapid-key.ts';
import Layout from '../../layouts/Layout.astro';
import NotifyCard from '../../components/pwa/NotifyCard.astro';
import { DEFAULT_REGION } from '../../lib/region/default-region.ts';
import { LOCALES } from '../../lib/i18n/locales.ts';
import { uiOf } from '../../lib/i18n/ui-of.ts';

export const getStaticPaths = () => LOCALES.filter((loc) => loc !== 'en').map((lang) => ({ params: { lang } }));

const lang = LOCALES.find((loc) => loc === Astro.params.lang) ?? 'en';
const ui = await uiOf(lang);

---

<Layout lang={lang} region={DEFAULT_REGION} title={ui.notify.title} path="notifications/">
  <h1>{ui.notify.title}</h1>
  <NotifyCard ui={ui} lang={lang} vapidKey={VAPID_PUBLIC_KEY} />
</Layout>

<script>
  import { initNotify } from '../../components/pwa/init-notify.ts';
  initNotify();
</script>
