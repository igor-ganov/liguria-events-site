---
// The draggable 56px round button itself; the wiring positions it at runtime.
---

<button
  type="button"
  class="mobile-fab"
  data-fab-toggle
  aria-label="Menu"
  aria-expanded="false"
  aria-controls="fab-popup"
>
  <span class="fab-line fab-line-1"></span>
  <span class="fab-line fab-line-2"></span>
  <span class="fab-line fab-line-3"></span>
</button>
