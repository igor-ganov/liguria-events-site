---
// Server-rendered, and that is the point: a prerendered 404.html is handed
// straight to the reader by the assets layer, which never runs the worker — so
// nothing here could look at the address that missed. Two-segment strays like
// /campania/<event id>/ match no route at all and land exactly here.
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { regionUrl } from '../lib/region/region-url.ts';
import { strayEventPath } from '../lib/events/stray-event-path.ts';
import { DEFAULT_REGION } from '../lib/region/default-region.ts';

const stray = strayEventPath(Astro.url.pathname);
switch (stray) {
  case undefined:
    break;
  default:
    return Astro.redirect(stray, 301);
}
const home = regionUrl('en', DEFAULT_REGION);
---

<Layout lang="en" title="Page not found" description="The page you were looking for could not be found.">
  <article class="legal">
    <h1>Page not found</h1>
    <p>
      We couldn't find the page you were looking for. It may have moved, or the link may be out of
      date.
    </p>
    <p><a href={home}>← Back to events</a></p>
  </article>
</Layout>
