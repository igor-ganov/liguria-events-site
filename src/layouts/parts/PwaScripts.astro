<script>
  // The service worker (offline pages, asset cache), the install offer, and
  // the bar that says a page came out of storage. Registered once per
  // document, not per SPA swap: the worker outlives both. The bar is redrawn
  // after a swap, because the new page may have come from somewhere else.
  import { initInstallPrompt } from '../../components/pwa/init-install-prompt.ts';
  import { initOutbox } from '../../components/events/init-outbox.ts';
  import { initFreshness } from '../../components/pwa/init-freshness.ts';
  import { warmLinks } from '../../components/pwa/warm-links.ts';
  import { registerServiceWorker } from '../../components/pwa/register-service-worker.ts';
  registerServiceWorker();
  initInstallPrompt();
  initFreshness();
  warmLinks();
  initOutbox();
  document.addEventListener('astro:page-load', initFreshness);
  document.addEventListener('astro:page-load', warmLinks);
  document.addEventListener('astro:page-load', initOutbox);
</script>
