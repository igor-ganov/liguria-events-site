---
import MobileMenu from '../components/MobileMenu.astro';
import NavProgress from './parts/NavProgress.astro';
import ShellScripts from './parts/ShellScripts.astro';
import SigninDialog from './parts/SigninDialog.astro';
import SiteFooter from './parts/SiteFooter.astro';
import SiteHead from './parts/SiteHead.astro';
import SiteHeader from './parts/SiteHeader.astro';
import { pageEvents } from './page-events.ts';
import { uiOf } from '../lib/i18n/ui-of.ts';
import { DEFAULT_REGION } from '../lib/region/default-region.ts';
import { LOCALES } from '../lib/i18n/locales.ts';
import type { LayoutProps } from './layout-props.ts';
import '../styles/global.css';

type Props = LayoutProps;
const {
  lang,
  title,
  region = DEFAULT_REGION,
  city,
  description = "What's on in Italy — auto-collected events",
  path = '',
  needsEvents = false,
  needsMap = false,
  image,
  locales = LOCALES,
} = Astro.props;
const payload = await pageEvents(needsEvents);
const ui = await uiOf(lang);
const uiData = JSON.stringify({ lang, ui });
---

<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead
      lang={lang}
      title={title}
      description={description}
      path={path}
      needsMap={needsMap}
      image={image}
      locales={locales}
      site={Astro.site}
    />
  </head>
  <body>
    <NavProgress />
    <SiteHeader lang={lang} region={region} path={path} city={city} ui={ui} />
    {payload && <script is:inline type="application/json" id="events-data" set:html={JSON.stringify(payload.events)} />}
    <script is:inline type="application/json" id="ui-data" set:html={uiData} />
    <main>
      <slot />
    </main>
    <MobileMenu lang={lang} path={path} region={region} />
    <SiteFooter ui={ui} generatedAt={payload?.generatedAt} />
    <SigninDialog ui={ui} />
    <ShellScripts />
  </body>
</html>
