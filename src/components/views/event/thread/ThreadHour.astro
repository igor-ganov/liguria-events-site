---
import UiIcon from '../../../shared/UiIcon.astro';
import type { WhenLine } from '../../../../lib/events/thread/when-line.ts';

// The hour large, and how it ends: an arrow to the end hour and "2h 30m" when
// a source said how long it lasts, "end not listed" when none did. Nothing at
// all with no hour. The arrow is drawing; the end hour is read out as it is.
type Props = Readonly<{ line: WhenLine; endUnknown: string }>;
const { line, endUnknown } = Astro.props;
---

{line.start !== undefined && (
  <p class="ev-hour">
    <time datetime={`${line.iso}T${line.start}`}>{line.start}</time>
    {line.end !== undefined && (
      <span class="ev-end">
        <span class="ev-arrow"><UiIcon name="arrowRight" size={20} /></span>
        <time datetime={line.end}>{line.end}</time>
      </span>
    )}
    {line.duration !== undefined && <span class="ev-dur">{line.duration}</span>}
    {line.end === undefined && <span class="ev-dur">{endUnknown}</span>}
  </p>
)}
