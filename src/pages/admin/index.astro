---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import ModerationRow from '../../components/admin/ModerationRow.astro';
import { listEventsByStatus } from '../../lib/events/list-events.ts';

const user = Astro.locals.user;
// Admins only — every other visitor gets a flat 403, no moderation surface.
switch (user?.role) {
  case 'admin':
    break;
  default:
    return new Response('Forbidden — admins only.', { status: 403 });
}
const env = Astro.locals.runtime.env;
const events = await listEventsByStatus(env.DB, ['pending', 'held', 'published', 'rejected']);
---

<Layout lang="en" title="Moderation" path="admin/">
  <main class="admin">
    <nav class="admin-tabs">
      <a href="/admin/" aria-current="page">Moderation</a>
      <a href="/admin/users/">Users</a>
    </nav>
    <h1>Moderation</h1>
    <p>{events.length} event(s). Newest first.</p>
    <table class="admin-table">
      <thead>
        <tr><th>Status</th><th>Title</th><th>Dates</th><th>Origin</th><th>Actions</th></tr>
      </thead>
      <tbody>
        {events.map((ev) => <ModerationRow event={ev} />)}
      </tbody>
    </table>
  </main>
</Layout>

<script>
  import { initAdminModeration } from '../../components/admin/init-admin-moderation.ts';
  initAdminModeration();
</script>

<style>
  .admin-tabs { display: flex; gap: 1rem; margin-bottom: 1rem; }
  .admin-tabs a { text-decoration: none; padding: 0.25rem 0.5rem; border-radius: 0.375rem; }
  .admin-tabs a[aria-current] { background: var(--surface-2, #eee); font-weight: 600; }
</style>
