---
import { localizedUrl } from '../../lib/i18n/localized-url.ts';
import RegionPicker from '../../components/RegionPicker.astro';
import SiteNav from './SiteNav.astro';
import { pageSegment } from '../../lib/region/page-segment.ts';
import { regionUrl } from '../../lib/region/region-url.ts';
import type { Locale } from '../../lib/i18n/locales.ts';
import type { Ui } from '../../lib/i18n/ui-schema.ts';

type Props = Readonly<{
  lang: Locale;
  region: string;
  path: string;
  city: string | undefined;
  ui: Ui;
}>;
const { lang, region, path, city, ui } = Astro.props;
---

<header class="site-head">
  <p class="site-title">
    <a class="brand" href={regionUrl(lang, region)} aria-label="Dove Go — home">
      <svg class="brand-mark" viewBox="0 0 32 40" width="19" height="24" aria-hidden="true">
        <path
          d="M16 1.6C8.6 1.6 2.6 7.5 2.6 14.9 2.6 24.4 16 38.4 16 38.4S29.4 24.4 29.4 14.9C29.4 7.5 23.4 1.6 16 1.6Z"
          fill="var(--brand)"
        ></path>
        <path
          d="M8.2 16.4C10.7 12.7 13.6 12.7 16 16.4 18.4 20.1 21.3 20.1 23.8 16.4"
          fill="none"
          stroke="#fff"
          stroke-width="2.7"
          stroke-linecap="round"
        ></path>
      </svg>
      <span class="brand-word">Dove <span class="brand-go">Go</span></span>
    </a>
  </p>
  <SiteNav lang={lang} region={region} path={path} ui={ui} />
  <!-- Outside the nav on purpose, like the region picker below: the nav is
       hidden on a phone, and making an event is the thing this site is for.
       Reachable without an account — the sign-in comes at the moment of
       publishing, by which point the draft is already saved. -->
  <a class="head-create" href={localizedUrl(lang, "submit/")}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
      <path d="M12,4.4 C12.2,9 12.1,14.8 11.9,19.6"></path>
      <path d="M4.4,12.1 C9,11.9 14.8,12 19.6,11.9"></path>
    </svg>
    <span>{ui.contribute.link}</span>
  </a>
  <!-- Outside the nav on purpose: the nav is hidden on a phone, and the
       region is the one control that must stay reachable everywhere. -->
  <RegionPicker lang={lang} region={region} page={pageSegment(path, city)} city={city} />
</header>
