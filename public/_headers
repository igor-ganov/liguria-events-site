# Content-hashed + stable assets are immutable — cache hard so repeat visits
# (and the heavy map bundle) load from cache instead of re-downloading.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/sprite/*
  Cache-Control: public, max-age=2592000
# Landmark data refreshes weekly (stable filename, not hashed) — cache a day and
# serve stale while revalidating, so repeat opt-ins are instant but never stale.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=2592000
# The worker script itself must never be held: a browser serving a stale sw.js
# keeps a stale routing table, and there is no way to reach it afterwards.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
# robots.txt and the sitemaps were served revalidate-on-every-read, and
# Googlebot took that literally: 189 fetches of robots.txt in the week to
# 15 November, 13% of everything it spent on the site. A day is what Google
# caches robots.txt for anyway, and the sitemaps change once a deploy.
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap-*
  Cache-Control: public, max-age=3600
