---
// The page the service worker keeps for when there is no network at all.
//
// It deliberately does not use Layout: everything it needs is inlined into the
// page itself, because the moment it links a stylesheet it is a page that can
// only be shown when the thing it is standing in for works. The one script it
// does load is precached under a fixed name for the same reason.
export const prerender = true;
import { OFFLINE_PIN } from '../lib/pwa/offline-pin.ts';
import { OFFLINE_STYLES } from '../lib/pwa/offline-styles.ts';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fbfaf7" />
    <title>Offline · Dove Go</title>
    <style is:global set:html={OFFLINE_STYLES}></style>
  </head>
  <body>
    <main>
      <Fragment set:html={OFFLINE_PIN} />
      <h1>No connection</h1>
      <p>This one was never opened on this device, so there is no copy of it here.</p>
      <button type="button" onclick="location.reload()">Try again</button>
      <nav class="kept" data-offline-list hidden aria-label="Available offline">
        <p class="kept-lead">What is on the device:</p>
      </nav>
    </main>
    <script type="module" src="/offline.js"></script>
  </body>
</html>
