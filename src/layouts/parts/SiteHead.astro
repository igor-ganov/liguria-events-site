---
import { ClientRouter } from 'astro:transitions';
import FeedFilterInit from './FeedFilterInit.astro';
import ThemeInit from './ThemeInit.astro';
import { alternateLinks } from '../../lib/seo/alternate-links.ts';
import SiteFeeds from './SiteFeeds.astro';
import SocialMeta from './SocialMeta.astro';
import WebAnalytics from './WebAnalytics.astro';
import { canonicalUrl } from '../../lib/seo/canonical-url.ts';
import { tilesOrigin } from '../../lib/seo/tiles-origin.ts';
import type { Locale } from '../../lib/i18n/locales.ts';

type Props = Readonly<{
  lang: Locale;
  title: string;
  description: string;
  path: string;
  needsMap: boolean;
  image: string | undefined;
  ogType: 'website' | 'article';
  noindex: boolean;
  locales: readonly Locale[];
  /** The region whose feeds this page can be subscribed to, when it has one. */
  region?: string | undefined;
  city?: string | undefined;
  site: URL | undefined;
}>;
const { lang, title, description, path, needsMap, image, ogType, noindex, locales, region, city, site } = Astro.props;
const tiles = tilesOrigin(import.meta.env.PUBLIC_PMTILES_URL);
const canonical = canonicalUrl(lang, path, site);
const icon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="hsl(28 92% 52%)" />
<link rel="icon" type="image/svg+xml" href={icon} />
<title>{title} · Dove Go</title>
{needsMap && tiles && <link rel="preconnect" href={tiles} crossorigin />}
{needsMap && tiles && <link rel="dns-prefetch" href={tiles} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
{
  alternateLinks(path, site, locales).map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))
}
<SiteFeeds region={region} city={city} site={site} />
<SocialMeta lang={lang} title={title} description={description} canonical={canonical} image={image} ogType={ogType} />
<WebAnalytics />
<ClientRouter />
<ThemeInit />
<FeedFilterInit />
